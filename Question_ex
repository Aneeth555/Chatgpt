# ---------------------------------------------------------
# NULL VALUE NORMALIZATION
# ---------------------------------------------------------

NULL_STRINGS = {
    "",
    "null",
    "none",
    "n/a",
    "na",
    "not available",
    "not disclosed",
    "not specified",
    "unknown",
    "not found"
}


def normalize_null_values(data):
    """
    Convert common empty or unavailable values into None.
    """

    if isinstance(data, dict):
        return {
            key: normalize_null_values(value)
            for key, value in data.items()
        }

    if isinstance(data, list):
        return [
            normalize_null_values(item)
            for item in data
        ]

    if isinstance(data, str):
        cleaned = data.strip()

        if cleaned.lower() in NULL_STRINGS:
            return None

        return cleaned

    return data


# ---------------------------------------------------------
# TEXT NORMALIZATION
# ---------------------------------------------------------

def normalize_text(text):
    """
    Normalize text for evidence matching.
    """

    if not text:
        return ""

    text = str(text).lower()

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    text = re.sub(
        r"[^\w\s.$%+-]",
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


