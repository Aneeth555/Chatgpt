 
import copy
import json
import re
import requests

from schemas.one_pager_schema import OnePagerExtraction
from schemas.field_definitions import get_field_definitions
from llm.ollama_client import MODEL_NAME


# ============================================================
# OLLAMA CONFIGURATION
# ============================================================

OLLAMA_URL = "http://localhost:11434/api/chat"

REQUEST_TIMEOUT = 300


# ============================================================
# FIELD DEFINITIONS
# ============================================================

def get_clean_field_definitions():
    """
    Return field definitions without example values.

    Only descriptions and extraction instructions are
    provided to Qwen.
    """

    definitions = get_field_definitions()

    clean_definitions = {}

    for section, fields in definitions.items():

        clean_definitions[section] = {}

        for field_name, definition in fields.items():

            clean_definitions[section][field_name] = {
                "description": definition.get("description", ""),
                "extract": definition.get("extract", "")
            }

    return clean_definitions


# ============================================================
# RESPONSE SCHEMA WITH EVIDENCE
# ============================================================

def get_questionnaire_response_schema():
    """
    Extend the original Pydantic schema with an evidence object.

    The original OnePagerExtraction schema remains unchanged.
    """

    schema = copy.deepcopy(
        OnePagerExtraction.model_json_schema()
    )

    evidence_item_schema = {
        "type": "object",
        "properties": {
            "evidence": {
                "type": ["string", "null"]
            }
        },
        "required": ["evidence"],
        "additionalProperties": False
    }

    schema["properties"]["evidence"] = {
        "type": "object",
        "properties": {
            "company": {
                "type": "object",
                "additionalProperties": evidence_item_schema
            },
            "product": {
                "type": "object",
                "additionalProperties": evidence_item_schema
            }
        },
        "required": ["company", "product"],
        "additionalProperties": False
    }

    schema["required"] = list(
        dict.fromkeys(
            schema.get("required", []) + ["evidence"]
        )
    )

    return schema


# ============================================================
# TEXT NORMALIZATION
# ============================================================

def normalize_text(text):
    """
    Normalize text for evidence comparison.

    Handles:
    - Uppercase/lowercase differences
    - Multiple spaces
    - Newlines
    - Tabs
    """

    if not isinstance(text, str):
        return ""

    return re.sub(
        r"\s+",
        " ",
        text
    ).strip().lower()


# ============================================================
# NORMALIZE NULL VALUES
# ============================================================

def normalize_null_values(data):
    """
    Convert textual representations of null into Python None.
    """

    if isinstance(data, dict):

        return {
            key: normalize_null_values(value)
            for key, value in data.items()
        }

    elif isinstance(data, list):

        return [
            normalize_null_values(item)
            for item in data
        ]

    elif isinstance(data, str):

        if data.strip().lower() in [
            "null",
            "none",
            "n/a",
            "not available",
            "not specified",
            "unknown"
        ]:
            return None

    return data


# ============================================================
# VERIFY QUESTIONNAIRE EVIDENCE
# ============================================================

def verify_questionnaire_evidence(
    extracted_data,
    evidence_data,
    questionnaire_text
):
    """
    Verify evidence against the original questionnaire.

    IMPORTANT:
    An answer is NOT deleted when evidence verification fails.

    Verification statuses:

        verified:
            Evidence quotation exists in questionnaire.

        needs_review:
            Answer exists, but evidence could not be verified.

        missing:
            Qwen returned no answer.

        user_input:
            Value was supplied directly by the user.
    """

    verified_evidence = {
        "company": {},
        "product": {}
    }

    normalized_questionnaire = normalize_text(
        questionnaire_text
    )

    for section in ["company", "product"]:

        section_data = extracted_data.get(section, {})

        section_evidence = evidence_data.get(section, {})

        for field_name, answer in section_data.items():

            field_evidence = section_evidence.get(
                field_name,
                {}
            )

            quotation = field_evidence.get("evidence")

            # ------------------------------------------------
            # USER-PROVIDED COMPANY AND PRODUCT NAMES
            # ------------------------------------------------

            if (
                (section == "company" and field_name == "company_name")
                or
                (section == "product" and field_name == "product_name")
            ):

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": "user_input",
                    "verification_status": "user_input"
                }

                continue

            # ------------------------------------------------
            # MISSING ANSWER
            # ------------------------------------------------

            if answer is None:

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": None,
                    "verification_status": "missing"
                }

                continue

            # ------------------------------------------------
            # MISSING EVIDENCE
            # ------------------------------------------------

            if (
                not isinstance(quotation, str)
                or not quotation.strip()
            ):

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": "questionnaire",
                    "verification_status": "needs_review"
                }

                continue

            normalized_quotation = normalize_text(
                quotation
            )

            # ------------------------------------------------
            # CHECK EVIDENCE
            # ------------------------------------------------

            if normalized_quotation in normalized_questionnaire:

                verification_status = "verified"

            else:

                verification_status = "needs_review"

            # ------------------------------------------------
            # PRESERVE ANSWER
            # ------------------------------------------------

            verified_evidence[section][field_name] = {
                "evidence": quotation.strip(),
                "source": "questionnaire",
                "verification_status": verification_status
            }

    return extracted_data, verified_evidence


# ============================================================
# PRINT EXTRACTION SUMMARY
# ============================================================

def print_extraction_summary(extracted_data, verified_evidence):
    """
    Display extracted answers and their verification status.
    """

    print("\n========== QUESTIONNAIRE EXTRACTION SUMMARY ==========")

    for section in ["company", "product"]:

        print(f"\n{section.upper()} FIELDS")

        for field_name, answer in extracted_data[section].items():

            evidence_info = verified_evidence[section].get(
                field_name,
                {}
            )

            status = evidence_info.get(
                "verification_status",
                "unknown"
            )

            print(f"\nField: {field_name}")
            print(f"Answer: {answer}")
            print(f"Status: {status}")


# ============================================================
# QUESTIONNAIRE EXTRACTION
# ============================================================

def extract_from_questionnaire(
    questionnaire_text: str,
    company_name: str,
    product_name: str,
    return_evidence: bool = False
):
    """
    Extract company and product information exclusively
    from the supplied questionnaire.

    Extraction flow:

        1. Read questionnaire.
        2. Load shared field definitions.
        3. Ask Qwen to extract answers and evidence.
        4. Verify evidence against questionnaire text.
        5. Preserve answers even when evidence needs review.
        6. Validate answers using Pydantic.

    By default, returns the original Pydantic model.

    When return_evidence=True, returns:

        (extracted_data, verified_evidence)
    """

    # --------------------------------------------------------
    # VALIDATE INPUT
    # --------------------------------------------------------

    if (
        not questionnaire_text
        or not questionnaire_text.strip()
    ):

        raise ValueError(
            "Questionnaire text is empty."
        )

    if not company_name or not company_name.strip():

        raise ValueError(
            "Company name is required."
        )

    if not product_name or not product_name.strip():

        raise ValueError(
            "Product name is required."
        )

    # --------------------------------------------------------
    # GET FIELD DEFINITIONS WITHOUT EXAMPLES
    # --------------------------------------------------------

    field_definitions = get_clean_field_definitions()

    schema = get_questionnaire_response_schema()

    # --------------------------------------------------------
    # SYSTEM PROMPT
    # --------------------------------------------------------

    system_prompt = """
You are a factual information extraction system.

Your task is to extract company and product information
ONLY from the supplied questionnaire.

Use the supplied one-pager field definitions to understand
what information is required for each field.

STRICT RULES:

1. Use only the supplied questionnaire.
2. Never use external knowledge or previously learned facts.
3. Never invent or assume information.
4. Return null when information is genuinely missing.
5. Do not copy example values or invent sample answers.
6. Do not confuse route_to_market with deployment_type.
7. Do not confuse funding with revenue.
8. Do not confuse partners with customers.
9. Do not assign information about another company
   to the user-entered company.
10. Every non-null answer should have supporting
    questionnaire evidence.
11. Evidence should be copied from the original
    questionnaire as accurately as possible.
12. Keep evidence concise. Prefer one or two complete
    sentences instead of copying long paragraphs.
13. Never invent evidence or use external knowledge.
14. If no relevant information exists in the questionnaire,
    return null for that field.
15. Preserve company and product names provided by the user.
16. Return every required field.
17. Return valid JSON matching the supplied schema.

IMPORTANT:

A field description explains what information is required.
It is not itself evidence.

Only questionnaire content can support an extracted answer.

Do not return null merely because information is expressed
in a different wording from the field description.

Extract the actual information when its meaning is clear.
"""

    # --------------------------------------------------------
    # USER PROMPT
    # --------------------------------------------------------

    user_prompt = f"""
USER-PROVIDED COMPANY NAME:

{company_name}


USER-PROVIDED PRODUCT NAME:

{product_name}


FIELD DEFINITIONS:

{json.dumps(
    field_definitions,
    indent=2,
    ensure_ascii=False
)}


QUESTIONNAIRE CONTENT:

{questionnaire_text}


YOUR TASK:

Extract company and product information from the questionnaire.

For every field:

1. Read its description.
2. Read its extraction instructions.
3. Find relevant information in the questionnaire.
4. Extract the answer when supported.
5. Provide a concise supporting quotation.
6. Return null only when the information is genuinely absent
   or cannot be identified confidently.

IMPORTANT FIELD INTERPRETATION:

- Company overview:
  Extract the company's business, technology, purpose,
  or main activities.

- Funding:
  Extract the funding amount and currency when available.

- Revenue:
  Extract the revenue amount and its unit/currency
  when available.

- Route to market:
  Extract the commercial strategy used to sell or distribute
  the product. Do not confuse this with deployment technology.

- Deployment type:
  Extract cloud, edge, on-premises, hybrid, or other
  explicitly supported deployment environments.

- Models:
  Extract model architectures and model names.

- Training hardware:
  Extract hardware used for model training.

- AI framework:
  Extract frameworks used for AI model development
  and training.

EVIDENCE REQUIREMENTS:

For every field, return an evidence object containing
an evidence property.

Evidence must be copied from the questionnaire.
Do not use field descriptions as evidence.

If an answer is null, its evidence must also be null.

EXPECTED JSON STRUCTURE:

- company: all company fields
- product: all product fields
- evidence: company and product evidence sections

Return JSON only.
"""

    # --------------------------------------------------------
    # OLLAMA REQUEST
    # --------------------------------------------------------

    payload = {
        "model": MODEL_NAME,
        "messages": [
            {
                "role": "system",
                "content": system_prompt
            },
            {
                "role": "user",
                "content": user_prompt
            }
        ],
        "format": schema,
        "stream": False,
        "think": False,
        "options": {
            "temperature": 0,
            "num_ctx": 8192,
            "num_predict": 4096
        }
    }

    print("\nConnecting to Ollama...")
    print("Model:", MODEL_NAME)
    print("API:", OLLAMA_URL)

    # --------------------------------------------------------
    # SEND REQUEST
    # --------------------------------------------------------

    try:

        response = requests.post(
            OLLAMA_URL,
            json=payload,
            timeout=REQUEST_TIMEOUT
        )

        response.raise_for_status()

    except requests.exceptions.RequestException as error:

        raise RuntimeError(
            f"Could not communicate with Ollama: {error}"
        ) from error

    response_data = response.json()

    # --------------------------------------------------------
    # READ MODEL RESPONSE
    # --------------------------------------------------------

    print("\n========== OLLAMA RESPONSE DETAILS ==========")

    print(
        "Done reason:",
        response_data.get("done_reason")
    )

    message = response_data.get("message", {})

    raw_output = message.get("content", "")

    if not raw_output or not raw_output.strip():

        print("Ollama returned empty message content.")

        raise ValueError(
            "Ollama returned empty content."
        )

    print("\n========== RAW QUESTIONNAIRE EXTRACTION ==========")

    print(raw_output)

    # --------------------------------------------------------
    # PARSE JSON RESPONSE
    # --------------------------------------------------------

    try:

        parsed_data = json.loads(raw_output)

        parsed_data = normalize_null_values(parsed_data)

        evidence_data = parsed_data.pop(
            "evidence",
            {}
        )

        # ----------------------------------------------------
        # VERIFY EVIDENCE
        # ----------------------------------------------------

        parsed_data, verified_evidence = (
            verify_questionnaire_evidence(
                extracted_data=parsed_data,
                evidence_data=evidence_data,
                questionnaire_text=questionnaire_text
            )
        )

        # ----------------------------------------------------
        # VALIDATE USING PYDANTIC
        # ----------------------------------------------------

        extracted_data = OnePagerExtraction.model_validate(
            parsed_data
        )

    except Exception as error:

        print("\nQuestionnaire extraction validation failed.")

        print(
            "Raw model response:",
            repr(raw_output)
        )

        raise error

    # --------------------------------------------------------
    # APPLY USER-PROVIDED NAMES
    # --------------------------------------------------------

    extracted_data.company.company_name = company_name

    extracted_data.product.product_name = product_name

    # --------------------------------------------------------
    # PRINT VERIFIED EVIDENCE
    # --------------------------------------------------------

    print("\n========== QUESTIONNAIRE EVIDENCE ==========")

    print(
        json.dumps(
            verified_evidence,
            indent=4,
            ensure_ascii=False
        )
    )

    # --------------------------------------------------------
    # PRINT EXTRACTION SUMMARY
    # --------------------------------------------------------

    print_extraction_summary(
        extracted_data.model_dump(),
        verified_evidence
    )

    # --------------------------------------------------------
    # RETURN RESULTS
    # --------------------------------------------------------

    if return_evidence:

        return extracted_data, verified_evidence

    return extracted_data
