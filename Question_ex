# ---------------------------------------------------------
# ANSWER GROUNDING VALIDATION
# ---------------------------------------------------------

def answer_is_grounded(answer, source_text, field_name):
    """
    Check whether an extracted answer is sufficiently supported
    by the supplied source text.
    """

    if answer is None:
        return True

    if not source_text:
        return False

    answer = str(answer).strip()

    if not answer:
        return True

    normalized_answer = normalize_text(answer)
    normalized_source = normalize_text(source_text)

    if not normalized_answer or not normalized_source:
        return False

    # -----------------------------------------------------
    # Check numeric values.
    # -----------------------------------------------------

    answer_numbers = re.findall(
        r"\b\d+(?:[.,]\d+)*(?:\s?%|\s?(?:million|billion|thousand|k|m|bn))?\b",
        answer.lower()
    )

    source_numbers = re.findall(
        r"\b\d+(?:[.,]\d+)*(?:\s?%|\s?(?:million|billion|thousand|k|m|bn))?\b",
        source_text.lower()
    )

    normalized_source_numbers = {
        re.sub(r"\s+", "", number)
        for number in source_numbers
    }

    for number in answer_numbers:
        normalized_number = re.sub(
            r"\s+",
            "",
            number
        )

        if normalized_number not in normalized_source_numbers:
            return False

    # -----------------------------------------------------
    # Check meaningful word overlap.
    # -----------------------------------------------------

    answer_words = {
        word
        for word in normalized_answer.split()
        if len(word) > 2 and word not in STOPWORDS
    }

    source_words = {
        word
        for word in normalized_source.split()
        if len(word) > 2 and word not in STOPWORDS
    }

    if not answer_words:
        return True

    matching_words = answer_words.intersection(source_words)

    overlap = len(matching_words) / len(answer_words)

    # Summary fields may contain reasonable paraphrasing.
    if field_name in SUMMARY_FIELDS:
        return overlap >= 0.40

    return overlap >= 0.60


# ---------------------------------------------------------
# EVIDENCE VERIFICATION
# ---------------------------------------------------------

def evidence_found(evidence, text):
    """
    Check whether the evidence is present in the source text.
    """

    if not evidence or not text:
        return False

    normalized_evidence = normalize_text(evidence)
    normalized_text = normalize_text(text)

    if not normalized_evidence or not normalized_text:
        return False

    # Exact normalized match.
    if normalized_evidence in normalized_text:
        return True

    # Fallback: compare meaningful words.
    evidence_words = {
        word
        for word in normalized_evidence.split()
        if len(word) > 2 and word not in STOPWORDS
    }

    text_words = {
        word
        for word in normalized_text.split()
        if len(word) > 2 and word not in STOPWORDS
    }

    if len(evidence_words) < 3:
        return False

    overlap = (
        len(evidence_words.intersection(text_words))
        / len(evidence_words)
    )

    return overlap >= 0.85


# ---------------------------------------------------------
# OLLAMA CONTEXT SIZE
# ---------------------------------------------------------

def choose_context_size(text):
    """
    Select a context window based on the supplied text length.
    """

    text_length = len(text or "")

    if text_length <= 4000:
        return 4096

    if text_length <= 10000:
        return 8192

    if text_length <= 20000:
        return 16384

    return 32768


# ---------------------------------------------------------
# OLLAMA API CALL
# ---------------------------------------------------------

def call_ollama(
    messages,
    response_format=None,
    num_predict=NUM_PREDICT,
    retry_on_length=True
):
    """
    Send a request to the local Ollama chat API.

    Returns the parsed assistant response.
    """

    context_text = "\n".join(
        str(message.get("content", ""))
        for message in messages
    )

    options = {
        "num_ctx": choose_context_size(context_text),
        "num_predict": num_predict,
        "temperature": 0
    }

    payload = {
        "model": MODEL_NAME,
        "messages": messages,
        "stream": False,
        "options": options
    }

    if response_format is not None:
        payload["format"] = response_format

    response = requests.post(
        OLLAMA_URL,
        json=payload,
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    result = response.json()

    message = result.get("message", {})

    content = message.get("content", "")

    if not content:
        raise ValueError(
            "Ollama returned an empty response."
        )

    # Retry if the model response was truncated.
    done_reason = result.get("done_reason")

    if retry_on_length and done_reason == "length":
        if num_predict < 2048:
            return call_ollama(
                messages=messages,
                response_format=response_format,
                num_predict=2048,
                retry_on_length=False
            )

        raise ValueError(
            "Ollama response was truncated. "
            "Increase num_predict or reduce the input context."
        )

    return content

# ---------------------------------------------------------
# QUESTIONNAIRE TEXT SPLITTING
# ---------------------------------------------------------

MARKER = re.compile(
    r"(?m)^\s*(?:Q(?:uestion)?\s*)?\d+[\s.):\-]+"
)


def split_long_unit(
    text,
    window_size=WINDOW_SIZE,
    overlap=WINDOW_OVERLAP
):
    """
    Split a long text unit into smaller overlapping sections.
    """

    text = str(text or "").strip()

    if not text:
        return []

    if len(text) <= window_size:
        return [text]

    chunks = []

    start = 0

    while start < len(text):

        end = min(
            start + window_size,
            len(text)
        )

        # Try to end at a sentence or word boundary.
        if end < len(text):

            boundary = max(
                text.rfind(". ", start, end),
                text.rfind("\n", start, end),
                text.rfind(" ", start, end)
            )

            if boundary > start:
                end = boundary + 1

        chunk = text[start:end].strip()

        if chunk:
            chunks.append(chunk)

        if end >= len(text):
            break

        start = max(
            end - overlap,
            start + 1
        )

    return chunks


def build_windows(text):
    """
    Split questionnaire text into relevant windows.

    Numbered questions are kept together where possible.
    """

    text = str(text or "").strip()

    if not text:
        return []

    markers = list(MARKER.finditer(text))

    units = []

    if markers:

        if markers[0].start() > 0:

            introduction = text[
                :markers[0].start()
            ].strip()

            if introduction:
                units.append(introduction)

        for index, marker in enumerate(markers):

            start = marker.start()

            if index + 1 < len(markers):
                end = markers[index + 1].start()
            else:
                end = len(text)

            unit = text[start:end].strip()

            if unit:
                units.append(unit)

    else:
        units = [text]

    windows = []

    for unit in units:

        windows.extend(
            split_long_unit(
                unit,
                window_size=WINDOW_SIZE,
                overlap=WINDOW_OVERLAP
            )
        )

    return windows


# ---------------------------------------------------------
# QUESTIONNAIRE FIELD HINT MATCHING
# ---------------------------------------------------------

def hint_matches(text, field_name):
    """
    Check whether a text passage contains hints related
    to a particular one-pager field.
    """

    normalized = normalize_text(text)

    hints = QUESTIONNAIRE_HINTS.get(
        field_name,
        []
    )

    for hint in hints:

        normalized_hint = normalize_text(hint)

        if normalized_hint and normalized_hint in normalized:
            return True

    return False


# ---------------------------------------------------------
# FIND RELEVANT WINDOWS FOR A FIELD
# ---------------------------------------------------------

def find_field_windows(
    windows,
    field_name,
    top_k=TOP_WINDOWS_PER_FIELD
):
    """
    Rank questionnaire windows based on their relevance
    to a particular field.
    """

    hints = QUESTIONNAIRE_HINTS.get(
        field_name,
        []
    )

    if not windows:
        return []

    ranked_windows = []

    for index, window in enumerate(windows):

        normalized_window = normalize_text(window)

        score = 0

        for hint in hints:

            normalized_hint = normalize_text(hint)

            if normalized_hint in normalized_window:
                score += 3

            else:

                hint_words = set(
                    normalized_hint.split()
                )

                window_words = set(
                    normalized_window.split()
                )

                if hint_words and hint_words.issubset(window_words):
                    score += 2

        if score > 0:

            ranked_windows.append(
                (
                    score,
                    index,
                    window
                )
            )

    # Prefer higher relevance scores.
    ranked_windows.sort(
        key=lambda item: (
            item[0],
            -item[1]
        ),
        reverse=True
    )

    selected = [
        item[2]
        for item in ranked_windows[:top_k]
    ]

    # If no matching hint is found, provide a small fallback
    # selection rather than returning unrelated empty context.
    if not selected:
        selected = windows[:min(top_k, len(windows))]

    return selected
