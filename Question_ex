import json
import re
import requests

from schemas.one_pager_schema import OnePagerExtraction
from schemas.field_definitions import get_field_definitions
from llm.ollama_client import MODEL_NAME


# ============================================================
# CONFIGURATION
# ============================================================

OLLAMA_URL = "http://localhost:11434/api/chat"

REQUEST_TIMEOUT = 300

NUM_CTX = 8192
NUM_PREDICT = 4096


# ============================================================
# FIELD DEFINITIONS
# ============================================================

def get_extraction_definitions():
    """
    Return the shared field definitions used by the
    questionnaire extractor.
    """

    all_definitions = get_field_definitions()

    extraction_definitions = {}

    for section_name, fields in all_definitions.items():

        extraction_definitions[section_name] = {}

        for field_name, definition in fields.items():

            extraction_definitions[section_name][field_name] = {
                "display_name": definition.get(
                    "display_name", field_name
                ),
                "description": definition.get("description", ""),
                "what_to_extract": definition.get(
                    "what_to_extract", ""
                ),
                "what_not_to_extract": definition.get(
                    "what_not_to_extract", ""
                ),
                "answer_format": definition.get(
                    "answer_format", ""
                ),
                "source_guidance": definition.get(
                    "source_guidance", ""
                )
            }

    return extraction_definitions


# ============================================================
# NORMALIZE NULL VALUES
# ============================================================

def normalize_null_values(data):
    """
    Convert empty strings and common null representations
    into Python None.
    """

    if isinstance(data, dict):

        return {
            key: normalize_null_values(value)
            for key, value in data.items()
        }

    if isinstance(data, list):

        return [
            normalize_null_values(value)
            for value in data
        ]

    if isinstance(data, str):

        cleaned = data.strip()

        if cleaned.lower() in {
            "",
            "null",
            "none",
            "n/a",
            "na",
            "not available",
            "not provided",
            "unknown"
        }:
            return None

        return cleaned

    return data


# ============================================================
# OLLAMA API CALL
# ============================================================

def call_ollama(
    prompt,
    output_schema,
    num_predict=NUM_PREDICT
):
    """
    Send a prompt to Ollama and request structured
    JSON output using the supplied JSON schema.
    """

    payload = {
        "model": MODEL_NAME,

        "messages": [
            {
                "role": "user",
                "content": prompt
            }
        ],

        "stream": False,

        "format": output_schema,

        "think": False,

        "options": {
            "temperature": 0,
            "num_ctx": NUM_CTX,
            "num_predict": num_predict
        }
    }

    try:

        response = requests.post(
            OLLAMA_URL,
            json=payload,
            timeout=REQUEST_TIMEOUT
        )

        response.raise_for_status()

        response_data = response.json()

        content = response_data.get(
            "message", {}
        ).get("content", "")

        if not content:
            raise ValueError(
                "Ollama returned an empty response."
            )

        content = content.strip()

        content = re.sub(
            r"^```(?:json)?\s*",
            "",
            content,
            flags=re.IGNORECASE
        )

        content = re.sub(
            r"\s*```$",
            "",
            content
        )

        return json.loads(content)

    except requests.exceptions.Timeout as error:

        raise RuntimeError(
            "Ollama request timed out. "
            "Try again or increase REQUEST_TIMEOUT."
        ) from error

    except requests.exceptions.RequestException as error:

        raise RuntimeError(
            f"Could not connect to Ollama: {error}"
        ) from error

    except json.JSONDecodeError as error:

        raise ValueError(
            f"Ollama did not return valid JSON. "
            f"Response: {content[:1000]}"
        ) from error
# ============================================================
# QUESTIONNAIRE ANSWER EXTRACTION
# ============================================================

def extract_questionnaire_answers(
    questionnaire_text: str,
    company_name: str,
    product_name: str
):
    """
    Extract company and product information using only
    the uploaded questionnaire.

    No web content is used in this stage.
    """

    if not questionnaire_text or not questionnaire_text.strip():

        raise ValueError(
            "Questionnaire text is empty."
        )

    field_definitions = get_extraction_definitions()

    output_schema = OnePagerExtraction.model_json_schema()

    prompt = f"""
You are an information extraction system.

Your task is to extract company and product information
from the uploaded questionnaire.

Follow the field definitions carefully.

============================================================
USER-PROVIDED INFORMATION
============================================================

Company name: {company_name}

Product name: {product_name}

These names are provided directly by the user.

Use these names as authoritative values for the
company_name and product_name fields.

Do not replace them with different names found in
the questionnaire.

============================================================
FIELD DEFINITIONS
============================================================

The following definitions describe every field that
must be extracted.

{json.dumps(field_definitions, indent=2, ensure_ascii=False)}

============================================================
EXTRACTION INSTRUCTIONS
============================================================

1. READ THE ENTIRE QUESTIONNAIRE

Read all available questionnaire content before extracting
the answers.

Do not depend only on headings or exact question wording.

2. UNDERSTAND THE MEANING OF EACH FIELD

Use the field descriptions, extraction instructions,
exclusions and answer formats.

Identify information based on its actual meaning.

The questionnaire may use different wording from the
field definitions.

Do not require an exact match between a questionnaire
question and a field name.

3. EXTRACT ALL SUPPORTED INFORMATION

Extract every field that is explicitly supported by
the questionnaire.

Do not leave a field empty merely because the information
appears under a different question or section.

A single questionnaire section may contain information
relevant to multiple fields.

4. DO NOT INVENT INFORMATION

Only extract information supported by the questionnaire.

Do not use your general knowledge to fill missing fields.

Do not assume a company has a particular customer,
partner, competitor, technology or location.

If the questionnaire does not provide sufficient
information for a field, return null.

5. PRESERVE NUMBERS AND TECHNICAL DETAILS

Preserve the original:

- Numbers
- Currency values
- Units
- Percentages
- Hardware model names
- Instance types
- Framework names
- Model names
- Version numbers
- Technology names

Do not round, convert, simplify or replace these values.

6. DISTINGUISH CURRENT AND FUTURE TECHNOLOGIES

Clearly distinguish between:

- Currently used technologies
- Technologies being evaluated
- Planned technologies
- Future optimization targets

Do not describe a planned technology as currently
implemented.

Preserve the status in the extracted answer.

7. AVOID FIELD CONFUSION

Follow these distinctions:

- Headquarters is not necessarily the same as a
  registered office, branch office or general address.

- Employee count must represent the company's workforce.
  Do not interpret a LinkedIn profile count or a number
  of visible employee profiles as the company's
  official employee count.

- Funding and revenue are different financial fields.

- A technical integration partner is not automatically
  a go-to-market partner.

- A customer is not automatically a partner.

- A company operating in the same industry is not
  automatically a direct competitor.

- Route to market means the commercial method used to
  sell, distribute or reach customers. It does not mean
  deployment architecture.

- Inference hardware and training hardware must be
  extracted separately.

- An AI model is not the same as an AI framework.

- A training framework is not automatically a serving
  framework.

- Supporting software and infrastructure tools should
  be distinguished from AI frameworks.

8. COMPANY AND PRODUCT SEPARATION

Company-level information belongs in the company object.

Product-level information belongs in the product object.

Do not place product-specific technical information
in company-level fields unless the field definition
explicitly requires it.

9. ANSWER FORMAT

Follow the answer format specified in each field definition.

Use concise but informative answers.

When a field requires multiple technologies or values,
include all relevant supported details.

Do not return URLs when a descriptive answer is expected.

10. OUTPUT

Return every field defined in the JSON schema.

Use null when the questionnaire does not contain
sufficient supporting information.

Return valid JSON only.

Do not include explanations, Markdown, comments or
additional fields.

============================================================
QUESTIONNAIRE CONTENT
============================================================

{questionnaire_text}
"""

    extracted_data = call_ollama(
        prompt=prompt,
        output_schema=output_schema
    )

    extracted_data = normalize_null_values(extracted_data)

    # User-provided names are authoritative.
    if "company" not in extracted_data:
        extracted_data["company"] = {}

    if "product" not in extracted_data:
        extracted_data["product"] = {}

    extracted_data["company"]["company_name"] = company_name

    extracted_data["product"]["product_name"] = product_name

    # Validate extracted data against the Pydantic schema.
    try:

        return OnePagerExtraction.model_validate(
            extracted_data
        )

    except Exception as error:

        raise ValueError(
            f"Questionnaire extraction validation failed: {error}"
        ) from error
# ============================================================
# EVIDENCE JSON SCHEMA
# ============================================================

def get_evidence_schema():
    """
    Create a JSON schema for extracting supporting
    questionnaire evidence.

    Evidence extraction is performed separately from
    answer extraction.
    """

    field_definitions = get_field_definitions()

    properties = {}

    for section_name, fields in field_definitions.items():

        section_properties = {}

        for field_name in fields:

            section_properties[field_name] = {
                "type": "object",

                "properties": {
                    "quote": {
                        "type": ["string", "null"]
                    },

                    "source": {
                        "type": ["string", "null"]
                    }
                },

                "required": [
                    "quote",
                    "source"
                ],

                "additionalProperties": False
            }

        properties[section_name] = {
            "type": "object",

            "properties": section_properties,

            "required": list(section_properties.keys()),

            "additionalProperties": False
        }

    return {
        "type": "object",

        "properties": properties,

        "required": list(properties.keys()),

        "additionalProperties": False
    }


# ============================================================
# QUESTIONNAIRE EVIDENCE EXTRACTION
# ============================================================

def extract_questionnaire_evidence(
    questionnaire_text: str,
    extracted_answers
):
    """
    Ask Qwen to identify supporting questionnaire text
    for each extracted answer.

    This is a separate LLM call.

    It does not modify the extracted answers.
    """

    if hasattr(extracted_answers, "model_dump"):

        answers_data = extracted_answers.model_dump()

    else:

        answers_data = extracted_answers

    evidence_schema = get_evidence_schema()

    prompt = f"""
You are an evidence extraction system.

Your task is to identify the questionnaire text that
supports each previously extracted answer.

You must not generate new answers.

============================================================
EXTRACTED ANSWERS
============================================================

{json.dumps(answers_data, indent=2, ensure_ascii=False)}

============================================================
INSTRUCTIONS
============================================================

1. Read the entire questionnaire.

2. For every extracted field, identify the exact
   questionnaire sentence or passage that supports it.

3. Return a short, relevant quotation.

4. Do not invent quotations.

5. Do not create evidence from general knowledge.

6. Do not use information from outside the questionnaire.

7. If no supporting text can be identified, return null
   for both quote and source.

8. The source must be "questionnaire" when a quotation
   is identified.

9. Evidence must support the corresponding field.
   Do not use an unrelated sentence simply because it
   contains similar words.

10. Do not change, correct, remove or rewrite any
    extracted answer.

11. Return every field required by the JSON schema.

12. Return valid JSON only.

============================================================
QUESTIONNAIRE CONTENT
============================================================

{questionnaire_text}
"""

    try:

        evidence = call_ollama(
            prompt=prompt,
            output_schema=evidence_schema,
            num_predict=NUM_PREDICT
        )

        return normalize_null_values(evidence)

    except Exception as error:

        print(
            "Warning: Questionnaire evidence extraction failed:",
            error
        )

        return {
            "company": {},
            "product": {}
        }
# ============================================================
# TEXT NORMALIZATION FOR EVIDENCE VERIFICATION
# ============================================================

def normalize_text(text):
    """
    Normalize text for quotation matching.

    This allows minor differences in whitespace,
    punctuation and letter casing.
    """

    if not text:
        return ""

    text = str(text).lower()

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    text = re.sub(
        r"[^\w\s]",
        "",
        text
    )

    return text.strip()


# ============================================================
# EVIDENCE VERIFICATION
# ============================================================

def verify_questionnaire_evidence(
    questionnaire_text: str,
    evidence_data: dict
):
    """
    Verify whether extracted evidence quotations appear
    in the original questionnaire.

    This function does not modify the extracted answers.

    needs_review indicates that the quotation could not
    be matched directly. It does not automatically mean
    the answer itself is incorrect.
    """

    normalized_questionnaire = normalize_text(
        questionnaire_text
    )

    verification_results = {}

    for section_name, fields in evidence_data.items():

        verification_results[section_name] = {}

        if not isinstance(fields, dict):
            continue

        for field_name, evidence in fields.items():

            if not isinstance(evidence, dict):

                verification_results[section_name][field_name] = {
                    "verified": False,
                    "needs_review": True,
                    "reason": "Invalid evidence format."
                }

                continue

            quote = evidence.get("quote")

            if not quote:

                verification_results[section_name][field_name] = {
                    "verified": False,
                    "needs_review": True,
                    "reason": "No supporting quotation found."
                }

                continue

            normalized_quote = normalize_text(quote)

            if not normalized_quote:

                verified = False

            else:

                verified = (
                    normalized_quote in normalized_questionnaire
                )

            verification_results[section_name][field_name] = {

                "verified": verified,

                "needs_review": not verified,

                "reason": (
                    "Quotation found in questionnaire."
                    if verified
                    else
                    "Quotation could not be matched exactly. "
                    "Manual review may be required."
                )
            }

    return verification_results


# ============================================================
# MAIN QUESTIONNAIRE EXTRACTION FUNCTION
# ============================================================

def extract_from_questionnaire(
    questionnaire_text: str,
    company_name: str,
    product_name: str,
    return_evidence=False
):
    """
    Main entry point for questionnaire extraction.

    Default:
        Returns the validated OnePagerExtraction object.

    If return_evidence=True:
        Returns:
            extracted_answers,
            evidence_data,
            evidence_verification
    """

    # STEP 1: Extract answers using questionnaire only.
    extracted_answers = extract_questionnaire_answers(
        questionnaire_text=questionnaire_text,
        company_name=company_name,
        product_name=product_name
    )

    if not return_evidence:

        return extracted_answers

    # STEP 2: Extract evidence separately.
    evidence_data = extract_questionnaire_evidence(
        questionnaire_text=questionnaire_text,
        extracted_answers=extracted_answers
    )

    # STEP 3: Verify evidence against original questionnaire.
    evidence_verification = verify_questionnaire_evidence(
        questionnaire_text=questionnaire_text,
        evidence_data=evidence_data
    )

    # Original extracted answers remain unchanged.
    return (
        extracted_answers,
        evidence_data,
        evidence_verification
    )
