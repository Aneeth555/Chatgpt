# ---------------------------------------------------------
# PARSE FIELD RESPONSE
# ---------------------------------------------------------

def parse_field_response(response_text):
    """
    Parse and validate the JSON returned by Ollama.
    """

    if not response_text:
        raise ValueError(
            "The model returned an empty response."
        )

    try:
        result = json.loads(response_text)

    except json.JSONDecodeError as exc:

        raise ValueError(
            "Ollama returned invalid JSON."
        ) from exc

    if not isinstance(result, dict):
        raise ValueError(
            "The extraction response must be a JSON object."
        )

    if "answer" not in result or "evidence" not in result:
        raise ValueError(
            "The response must contain answer and evidence."
        )

    answer = result["answer"]
    evidence = result["evidence"]

    if answer is not None and not isinstance(answer, str):
        raise ValueError(
            "The extracted answer must be a string or null."
        )

    if evidence is not None and not isinstance(evidence, str):
        raise ValueError(
            "The evidence must be a string or null."
        )

    result["answer"] = normalize_null_values(answer)
    result["evidence"] = normalize_null_values(evidence)

    if result["answer"] is None:
        result["evidence"] = None

    return result
# ---------------------------------------------------------
# EXTRACT ONE FIELD
# ---------------------------------------------------------

def extract_one_field(
    field_name,
    passages,
    definition,
    source_name="questionnaire"
):
    """
    Extract one field using only the supplied passages.

    Returns:
        answer
        evidence
    """

    if not passages:
        return None, None

    source_text = "\n\n".join(
        str(passage)
        for passage in passages
        if passage
    ).strip()

    if not source_text:
        return None, None

    instruction = build_instruction(
        field_name,
        definition
    )

    user_prompt = f"""
FIELD NAME:
{field_name}

SOURCE TYPE:
{source_name}

FIELD INSTRUCTIONS:
{instruction}

SOURCE PASSAGES:
<source>
{source_text}
</source>

Extract the answer using only the source passages.

Return:
- answer: concise extracted information or null
- evidence: exact supporting text copied from the source

Return only valid JSON.
"""

    messages = [
        {
            "role": "system",
            "content": SYSTEM_PROMPT
        },
        {
            "role": "user",
            "content": user_prompt
        }
    ]

    response_text = call_ollama(
        messages=messages,
        response_format=FIELD_ANSWER_SCHEMA
    )

    result = parse_field_response(
        response_text
    )

    answer = result["answer"]
    evidence = result["evidence"]

    if answer is None:
        return None, None

    if not evidence:
        print(
            f"[WARNING] Missing evidence for {field_name}"
        )
        return None, None

    # Verify that the evidence belongs to the supplied passages.
    if not evidence_found(
        evidence,
        source_text
    ):
        print(
            f"[WARNING] Evidence verification failed: {field_name}"
        )
        return None, None

    # Verify that the answer is grounded in the source.
    if not answer_is_grounded(
        answer,
        source_text,
        field_name
    ):
        print(
            f"[WARNING] Grounding verification failed: {field_name}"
        )
        return None, None

    return answer, evidence
# ---------------------------------------------------------
# EXTRACT ALL QUESTIONNAIRE ANSWERS
# ---------------------------------------------------------

def extract_questionnaire_answers(
    questionnaire_text,
    company_name=None,
    product_name=None
):
    """
    Extract all company and product fields from the questionnaire.

    The supplied company and product names are treated as
    authoritative and are not re-generated by the LLM.

    Returns:
        extracted_data
        evidence_data
    """

    if not questionnaire_text:
        raise ValueError(
            "Questionnaire text cannot be empty."
        )

    print("\nStarting questionnaire extraction...")

    # Split questionnaire into manageable windows.
    windows = build_windows(
        questionnaire_text
    )

    if not windows:
        raise ValueError(
            "No usable questionnaire text was found."
        )

    print(
        f"Created {len(windows)} questionnaire windows."
    )

    definitions = get_field_definitions()

    extracted_data = {
        "company": {},
        "product": {}
    }

    evidence_data = {
        "company": {},
        "product": {}
    }

    total_fields = sum(
        len(section)
        for section in definitions.values()
    )

    completed_fields = 0

    # -----------------------------------------------------
    # Extract each field.
    # -----------------------------------------------------

    for section_name, section_fields in definitions.items():

        print(
            f"\nExtracting {section_name.upper()} information..."
        )

        for field_name, definition in section_fields.items():

            completed_fields += 1

            print(
                f"[{completed_fields}/{total_fields}] "
                f"Extracting: {field_name}"
            )

            # User-provided names take priority.
            if field_name == "company_name":

                extracted_data[section_name][field_name] = (
                    company_name.strip()
                    if company_name
                    else None
                )

                evidence_data[section_name][field_name] = None

                continue

            if field_name == "product_name":

                extracted_data[section_name][field_name] = (
                    product_name.strip()
                    if product_name
                    else None
                )

                evidence_data[section_name][field_name] = None

                continue

            # Find relevant questionnaire passages.
            relevant_passages = find_field_windows(
                windows,
                field_name,
                top_k=TOP_WINDOWS_PER_FIELD
            )

            if not relevant_passages:

                extracted_data[section_name][field_name] = None
                evidence_data[section_name][field_name] = None

                continue

            # Extract one field.
            try:

                answer, evidence = extract_one_field(
                    field_name=field_name,
                    passages=relevant_passages,
                    definition=definition,
                    source_name="questionnaire"
                )

            except Exception as exc:

                print(
                    f"[ERROR] Could not extract "
                    f"{field_name}: {exc}"
                )

                answer = None
                evidence = None

            extracted_data[section_name][field_name] = answer

            evidence_data[section_name][field_name] = evidence

            if answer is not None:
                print(
                    f"  Extracted: {answer}"
                )
            else:
                print(
                    "  No sufficiently supported answer found."
                )

    # -----------------------------------------------------
    # Validate extracted structure.
    # -----------------------------------------------------

    extracted_data = normalize_null_values(
        extracted_data
    )

    validated_data = OnePagerExtraction.model_validate(
        extracted_data
    )

    extracted_data = validated_data.model_dump(
        mode="json"
    )

    print("\nQuestionnaire extraction completed.")

    return extracted_data, evidence_data

# ---------------------------------------------------------
# VERIFY QUESTIONNAIRE EVIDENCE
# ---------------------------------------------------------

def verify_questionnaire_evidence(
    extracted_data,
    evidence_data,
    questionnaire_text
):
    """
    Verify that every extracted questionnaire answer has
    supporting evidence in the original questionnaire.

    Returns a verification report.
    """

    verification = {
        "verified": True,
        "total_checked": 0,
        "passed": 0,
        "failed": 0,
        "fields": {
            "company": {},
            "product": {}
        }
    }

    for section_name, section_fields in extracted_data.items():

        for field_name, answer in section_fields.items():

            # User-provided names are authoritative.
            if field_name in NAME_FIELDS:
                verification["fields"][section_name][field_name] = {
                    "status": "authoritative_input",
                    "verified": True
                }
                continue

            if answer is None:
                verification["fields"][section_name][field_name] = {
                    "status": "not_found",
                    "verified": True
                }
                continue

            verification["total_checked"] += 1

            evidence = (
                evidence_data
                .get(section_name, {})
                .get(field_name)
            )

            evidence_valid = evidence_found(
                evidence,
                questionnaire_text
            )

            answer_valid = answer_is_grounded(
                answer,
                questionnaire_text,
                field_name
            )

            field_verified = (
                evidence_valid and answer_valid
            )

            if field_verified:
                verification["passed"] += 1

                status = "verified"

            else:
                verification["failed"] += 1
                verification["verified"] = False

                status = "failed"

                # Do not retain an answer that fails
                # final questionnaire verification.
                extracted_data[section_name][field_name] = None
                evidence_data[section_name][field_name] = None

            verification["fields"][section_name][field_name] = {
                "status": status,
                "verified": field_verified
            }

    print("\nQuestionnaire evidence verification completed.")

    print(
        f"Total checked: {verification['total_checked']}"
    )

    print(
        f"Passed: {verification['passed']}"
    )

    print(
        f"Failed: {verification['failed']}"
    )

    return verification


# ---------------------------------------------------------
# PUBLIC QUESTIONNAIRE EXTRACTION FUNCTION
# ---------------------------------------------------------

def extract_from_questionnaire(
    questionnaire_text,
    company_name=None,
    product_name=None,
    return_evidence=False,
    return_verification=False
):
    """
    Main public function for questionnaire extraction.

    Parameters:
        questionnaire_text:
            Extracted text from the questionnaire.

        company_name:
            Company name supplied by the user.

        product_name:
            Product name supplied by the user.

        return_evidence:
            If True, also return field-level evidence.

        return_verification:
            If True, also return evidence verification report.

    Returns:
        extracted_data

        If return_evidence=True:
            extracted_data, evidence_data

        If return_verification=True:
            extracted_data, evidence_data, verification
    """

    extracted_data, evidence_data = extract_questionnaire_answers(
        questionnaire_text=questionnaire_text,
        company_name=company_name,
        product_name=product_name
    )

    verification = verify_questionnaire_evidence(
        extracted_data=extracted_data,
        evidence_data=evidence_data,
        questionnaire_text=questionnaire_text
    )

    # Validate the final structure after verification.
    validated_data = OnePagerExtraction.model_validate(
        extracted_data
    )

    extracted_data = validated_data.model_dump(
        mode="json"
    )

    if return_verification:
        return (
            extracted_data,
            evidence_data,
            verification
        )

    if return_evidence:
        return (
            extracted_data,
            evidence_data
        )

    return extracted_data

