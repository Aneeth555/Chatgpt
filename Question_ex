
import json
import re
import requests

from schemas.one_pager_schema import OnePagerExtraction
from schemas.field_definitions import get_field_definitions
from llm.ollama_client import MODEL_NAME


# ============================================================
# OLLAMA CONFIGURATION
# ============================================================

OLLAMA_URL = "http://localhost:11434/api/chat"
REQUEST_TIMEOUT = 300


# ============================================================
# FIELD DEFINITIONS
# ============================================================

def get_clean_field_definitions():
    """
    Get shared field definitions without example values.

    The same definitions are used by the original
    questionnaire extraction process.
    """

    definitions = get_field_definitions()

    clean_definitions = {}

    for section, fields in definitions.items():

        clean_definitions[section] = {}

        for field_name, definition in fields.items():

            clean_definitions[section][field_name] = {
                "description": definition.get("description", ""),
                "extract": definition.get("extract", "")
            }

    return clean_definitions


# ============================================================
# TEXT NORMALIZATION
# ============================================================

def normalize_text(text):
    """
    Normalize whitespace and case for evidence comparison.
    """

    if not isinstance(text, str):
        return ""

    return re.sub(r"\s+", " ", text).strip().lower()


# ============================================================
# NULL NORMALIZATION
# ============================================================

def normalize_null_values(data):
    """
    Convert textual null representations into Python None.
    """

    if isinstance(data, dict):

        return {
            key: normalize_null_values(value)
            for key, value in data.items()
        }

    if isinstance(data, list):

        return [
            normalize_null_values(item)
            for item in data
        ]

    if isinstance(data, str):

        if data.strip().lower() in [
            "null",
            "none",
            "n/a",
            "not available",
            "not specified",
            "unknown"
        ]:
            return None

    return data


# ============================================================
# OLLAMA CHAT REQUEST
# ============================================================

def call_ollama(messages, response_format):
    """
    Common Ollama API request function.
    """

    payload = {
        "model": MODEL_NAME,
        "messages": messages,
        "format": response_format,
        "stream": False,
        "think": False,
        "options": {
            "temperature": 0,
            "num_ctx": 8192,
            "num_predict": 4096
        }
    }

    response = requests.post(
        OLLAMA_URL,
        json=payload,
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    response_data = response.json()

    raw_output = response_data.get(
        "message", {}
    ).get("content", "")

    if not raw_output or not raw_output.strip():

        raise ValueError(
            "Ollama returned empty content."
        )

    return raw_output


# ============================================================
# STEP 1: ORIGINAL QUESTIONNAIRE EXTRACTION
# ============================================================

def extract_questionnaire_answers(
    questionnaire_text,
    company_name,
    product_name
):
    """
    Extract company and product information from the
    questionnaire using the original Pydantic schema.

    This step does NOT include evidence extraction.
    """

    field_definitions = get_clean_field_definitions()

    schema = OnePagerExtraction.model_json_schema()

    system_prompt = """
You are a factual information extraction system.

Extract company and product information ONLY from
the supplied questionnaire.

STRICT RULES:

1. Use only the supplied questionnaire.
2. Never use external knowledge or previously learned facts.
3. Never invent or assume information.
4. Return null when information is genuinely missing or unclear.
5. Do not confuse route_to_market with deployment_type.
6. Do not confuse funding with revenue.
7. Do not confuse partners with customers.
8. Do not assign information about another company
   to the user-entered company.
9. Follow the supplied field descriptions and extraction
   instructions.
10. Preserve the company and product names supplied by
    the user.
11. Return every required field.
12. Return valid JSON matching the supplied schema.

IMPORTANT:

A field description explains what information is required.
It is not evidence.

Extract information based on its actual meaning in
the questionnaire.

Do not use external knowledge.
"""

    user_prompt = f"""
USER-PROVIDED COMPANY NAME:

{company_name}


USER-PROVIDED PRODUCT NAME:

{product_name}


FIELD DEFINITIONS:

{json.dumps(
    field_definitions,
    indent=2,
    ensure_ascii=False
)}


QUESTIONNAIRE CONTENT:

{questionnaire_text}


YOUR TASK:

Extract all company and product information from
the questionnaire.

For every field:

1. Understand the field description.
2. Read the extraction instructions.
3. Find the relevant information in the questionnaire.
4. Extract the answer when information is available.
5. Return null only when the information is genuinely
   missing or unclear.

IMPORTANT:

- Funding and revenue are different fields.
- Preserve monetary units and currencies.
- Preserve employee ranges when available.
- Do not confuse LinkedIn followers with employee count.
- Do not confuse technical deployment with route to market.
- Do not confuse customers with partners.
- Do not assign information belonging to another company
  to the requested company.

Return all fields using the supplied JSON schema.
Return JSON only.
"""

    print("\n========== STEP 1: QUESTIONNAIRE ANSWER EXTRACTION ==========")

    print("Connecting to Ollama...")
    print("Model:", MODEL_NAME)

    raw_output = call_ollama(
        messages=[
            {
                "role": "system",
                "content": system_prompt
            },
            {
                "role": "user",
                "content": user_prompt
            }
        ],
        response_format=schema
    )

    print("\n========== RAW QUESTIONNAIRE EXTRACTION ==========")

    print(raw_output)

    try:

        parsed_data = json.loads(raw_output)

        parsed_data = normalize_null_values(parsed_data)

        extracted_data = OnePagerExtraction.model_validate(
            parsed_data
        )

    except Exception as error:

        print("\nQuestionnaire answer extraction failed.")

        print("Raw response:", repr(raw_output))

        raise error

    # User-provided names are authoritative.
    extracted_data.company.company_name = company_name
    extracted_data.product.product_name = product_name

    print("\nOriginal questionnaire extraction successful.")

    return extracted_data


# ============================================================
# STEP 2: BUILD SEPARATE EVIDENCE RESPONSE SCHEMA
# ============================================================

def get_evidence_response_schema():
    """
    Build a schema for evidence extraction only.

    This schema is completely separate from the
    original OnePagerExtraction schema.
    """

    definitions = get_field_definitions()

    evidence_item_schema = {
        "type": "object",
        "properties": {
            "evidence": {
                "type": ["string", "null"]
            }
        },
        "required": ["evidence"],
        "additionalProperties": False
    }

    evidence_properties = {}

    for section, fields in definitions.items():

        evidence_properties[section] = {
            "type": "object",
            "properties": {
                field_name: evidence_item_schema
                for field_name in fields.keys()
            },
            "required": list(fields.keys()),
            "additionalProperties": False
        }

    return {
        "type": "object",
        "properties": evidence_properties,
        "required": list(evidence_properties.keys()),
        "additionalProperties": False
    }


# ============================================================
# STEP 3: EXTRACT SOURCE EVIDENCE SEPARATELY
# ============================================================

def extract_questionnaire_evidence(
    extracted_data,
    questionnaire_text
):
    """
    Find the original questionnaire passage supporting
    each already-extracted answer.

    This function must never modify extracted_data.
    """

    answer_data = extracted_data.model_dump()

    evidence_schema = get_evidence_response_schema()

    system_prompt = """
You are a questionnaire evidence identification system.

Your task is ONLY to locate supporting passages
for already-extracted answers.

You must NOT extract new answers.
You must NOT modify existing answers.
You must NOT use external knowledge.

STRICT RULES:

1. Use only the supplied questionnaire.
2. Read the provided answer for each field.
3. Locate the passage that supports that answer.
4. Copy the relevant passage from the questionnaire.
5. Do not invent or paraphrase evidence.
6. Prefer concise, complete sentences.
7. If the answer is null, return null evidence.
8. If supporting information cannot be located,
   return null evidence.
9. Do not use information from another company.
10. Return every required evidence field.
11. Return valid JSON matching the supplied schema.

IMPORTANT:

Your task is evidence identification, not answer extraction.

Never change, correct, replace, or reinterpret
the supplied answers.
"""

    user_prompt = f"""
EXTRACTED COMPANY AND PRODUCT ANSWERS:

{json.dumps(
    answer_data,
    indent=2,
    ensure_ascii=False
)}


ORIGINAL QUESTIONNAIRE:

{questionnaire_text}


YOUR TASK:

For every non-null answer, locate the supporting
text in the original questionnaire.

Return the shortest complete passage that clearly
supports the answer.

For example:

Answer:
"400K USD"

Questionnaire passage:
"Company Revenue and Funding
Revenue: 5.2M
Funding: Yes. 400K USD"

Evidence:
"Funding: Yes. 400K USD"

If an answer is null, its evidence must be null.

Do not generate or change any answers.

Return only the evidence JSON.
"""

    print("\n========== STEP 2: SOURCE EVIDENCE EXTRACTION ==========")

    try:

        raw_output = call_ollama(
            messages=[
                {
                    "role": "system",
                    "content": system_prompt
                },
                {
                    "role": "user",
                    "content": user_prompt
                }
            ],
            response_format=evidence_schema
        )

        print("\n========== RAW EVIDENCE EXTRACTION ==========")

        print(raw_output)

        evidence_data = json.loads(raw_output)

        evidence_data = normalize_null_values(evidence_data)

        return evidence_data

    except Exception as error:

        print("\nEvidence extraction failed:", error)

        print(
            "Original extracted answers will be preserved."
        )

        return {
            section: {
                field_name: {
                    "evidence": None
                }
                for field_name in fields
            }
            for section, fields in get_field_definitions().items()
        }


# ============================================================
# STEP 4: CHECK EVIDENCE WITHOUT CHANGING ANSWERS
# ============================================================

def verify_questionnaire_evidence(
    extracted_data,
    evidence_data,
    questionnaire_text
):
    """
    Check whether the evidence quotation exists
    in the original questionnaire.

    IMPORTANT:
    This function only verifies evidence.
    It never changes extracted answers.
    """

    verified_evidence = {
        "company": {},
        "product": {}
    }

    normalized_questionnaire = normalize_text(
        questionnaire_text
    )

    answer_data = extracted_data.model_dump()

    for section in ["company", "product"]:

        for field_name, answer in answer_data[section].items():

            field_evidence = evidence_data.get(
                section, {}
            ).get(
                field_name, {}
            )

            quotation = field_evidence.get("evidence")

            # User-provided names
            if (
                (section == "company" and field_name == "company_name")
                or
                (section == "product" and field_name == "product_name")
            ):

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": "user_input",
                    "verification_status": "user_input"
                }

                continue

            # No answer was extracted
            if answer is None:

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": None,
                    "verification_status": "missing"
                }

                continue

            # Evidence not returned
            if (
                not isinstance(quotation, str)
                or not quotation.strip()
            ):

                verified_evidence[section][field_name] = {
                    "evidence": None,
                    "source": "questionnaire",
                    "verification_status": "evidence_not_found"
                }

                continue

            normalized_quotation = normalize_text(
                quotation
            )

            # Exact normalized text comparison
            if normalized_quotation in normalized_questionnaire:

                status = "verified"

            else:

                status = "needs_review"

            verified_evidence[section][field_name] = {
                "evidence": quotation.strip(),
                "source": "questionnaire",
                "verification_status": status
            }

    # Return the original Pydantic object unchanged.
    return extracted_data, verified_evidence


# ============================================================
# PRINT EXTRACTION SUMMARY
# ============================================================

def print_extraction_summary(
    extracted_data,
    verified_evidence
):
    """
    Display answers and their corresponding source evidence.
    """

    answer_data = extracted_data.model_dump()

    print("\n========== FINAL QUESTIONNAIRE ANSWERS ==========")

    print(
        json.dumps(
            answer_data,
            indent=4,
            ensure_ascii=False
        )
    )

    print("\n========== QUESTIONNAIRE SOURCE EVIDENCE ==========")

    print(
        json.dumps(
            verified_evidence,
            indent=4,
            ensure_ascii=False
        )
    )


# ============================================================
# MAIN QUESTIONNAIRE EXTRACTION FUNCTION
# ============================================================

def extract_from_questionnaire(
    questionnaire_text: str,
    company_name: str,
    product_name: str,
    return_evidence: bool = False
):
    """
    Main questionnaire extraction function.

    Step 1:
        Extract answers using the original Pydantic schema.

    Step 2:
        Extract source evidence in a separate LLM request.

    Step 3:
        Verify evidence without modifying answers.

    Default return:
        OnePagerExtraction object.

    When return_evidence=True:
        Returns (extracted_data, verified_evidence).
    """

    if not questionnaire_text or not questionnaire_text.strip():

        raise ValueError(
            "Questionnaire text is empty."
        )

    if not company_name or not company_name.strip():

        raise ValueError(
            "Company name is required."
        )

    if not product_name or not product_name.strip():

        raise ValueError(
            "Product name is required."
        )

    # --------------------------------------------------------
    # STEP 1: ORIGINAL ANSWER EXTRACTION
    # --------------------------------------------------------

    extracted_data = extract_questionnaire_answers(
        questionnaire_text=questionnaire_text,
        company_name=company_name,
        product_name=product_name
    )

    # --------------------------------------------------------
    # STEP 2: SEPARATE EVIDENCE EXTRACTION
    # --------------------------------------------------------

    evidence_data = extract_questionnaire_evidence(
        extracted_data=extracted_data,
        questionnaire_text=questionnaire_text
    )

    # --------------------------------------------------------
    # STEP 3: VERIFY EVIDENCE ONLY
    # --------------------------------------------------------

    extracted_data, verified_evidence = (
        verify_questionnaire_evidence(
            extracted_data=extracted_data,
            evidence_data=evidence_data,
            questionnaire_text=questionnaire_text
        )
    )

    # --------------------------------------------------------
    # DISPLAY RESULTS
    # --------------------------------------------------------

    print_extraction_summary(
        extracted_data=extracted_data,
        verified_evidence=verified_evidence
    )

    # --------------------------------------------------------
    # RETURN RESULTS
    # --------------------------------------------------------

    if return_evidence:

        return extracted_data, verified_evidence

    return extracted_data
