 
import json
import requests

from schemas.one_pager_schema import OnePagerExtraction
from schemas.field_definitions import get_field_definitions
from llm.ollama_client import MODEL_NAME


OLLAMA_URL = "http://localhost:11434/api/chat"


def extract_from_questionnaire(
    questionnaire_text: str,
    company_name: str,
    product_name: str
):
    if not questionnaire_text or not questionnaire_text.strip():
        raise ValueError("Questionnaire text is empty.")

    field_definitions = get_field_definitions()
    schema = OnePagerExtraction.model_json_schema()

    system_prompt = """
You are an information extraction system.

Extract company and product information ONLY from
the supplied questionnaire.

STRICT RULES:
1. Do not use external knowledge.
2. Do not invent or assume information.
3. Use null when information is missing or unclear.
4. Do not confuse route_to_market with deployment_type.
5. Do not confuse funding with revenue.
6. Do not confuse partners with customers.
7. Follow the supplied JSON schema exactly.
8. Include every required field.
9. Return valid JSON only.
"""

    user_prompt = f"""
COMPANY NAME:
{company_name}

PRODUCT NAME:
{product_name}

FIELD DEFINITIONS:
{json.dumps(field_definitions, indent=2)}

QUESTIONNAIRE:
{questionnaire_text}

Extract the information into the required JSON structure.
Use null for unsupported fields.
"""

    payload = {
        "model": MODEL_NAME,
        "messages": [
            {
                "role": "system",
                "content": system_prompt
            },
            {
                "role": "user",
                "content": user_prompt
            }
        ],
        "format": schema,
        "stream": False,
        "think": False,
        "options": {
            "temperature": 0,
            "num_predict": 2048
        }
    }

    print("\nConnecting to Ollama...")
    print("Model:", MODEL_NAME)
    print("API:", OLLAMA_URL)

    try:
        response = requests.post(
            OLLAMA_URL,
            json=payload,
            timeout=300
        )

        response.raise_for_status()

    except requests.exceptions.RequestException as error:
        raise RuntimeError(
            f"Could not communicate with Ollama: {error}"
        ) from error

    response_data = response.json()

    # Debug: inspect the Ollama response
    print("\n========== OLLAMA RESPONSE DETAILS ==========")
    print("Response keys:", list(response_data.keys()))
    print("Done reason:", response_data.get("done_reason"))

    message = response_data.get("message", {})

    print("Message keys:", list(message.keys()))

    raw_output = message.get("content", "")

    # Check for empty output before Pydantic validation
    if not raw_output or not raw_output.strip():

        thinking_output = message.get("thinking", "")

        print("\nOllama returned empty message content.")

        if thinking_output:
            print("Thinking content was returned.")
            print(thinking_output[:1000])

        print("\nComplete response for debugging:")
        print(json.dumps(response_data, indent=2))

        raise ValueError(
            "Ollama returned empty content. "
            "Check the response details printed above."
        )

    print("\n========== RAW QUESTIONNAIRE EXTRACTION ==========")
    print(raw_output)

    # Validate JSON using Pydantic
