# ============================================================
# FIELD INSTRUCTIONS (no source_guidance: it describes web
# sources and is useless for a questionnaire)
# ============================================================

def build_instruction(definition):

    parts = [
        ("What to extract", definition.get("what_to_extract", "")),
        ("What NOT to extract", definition.get("what_not_to_extract", "")),
        ("Answer format", definition.get("answer_format", ""))
    ]

    return "\n".join(
        f"- {label}: {text}" for label, text in parts if text
    )


# ============================================================
# NORMALIZE NULL VALUES / FIT THE SCHEMA
# ============================================================

NULL_STRINGS = {
    "", "null", "none", "n/a", "na", "not available", "not provided",
    "not specified", "unknown", "string", "not found",
    "extracted answer", "extracted answer or null"
}


def normalize_null_values(data):
    """Convert empty strings and placeholder text into None."""

    if isinstance(data, dict):

        return {
            key: normalize_null_values(value)
            for key, value in data.items()
        }

    if isinstance(data, list):

        items = [normalize_null_values(value) for value in data]

        return [item for item in items if item is not None]

    if isinstance(data, str):

        cleaned = data.strip()

        if cleaned.lower().strip(".") in NULL_STRINGS:
            return None

        if " or null" in cleaned.lower():
            return None

        return cleaned

    return data


# ============================================================
# TEXT HELPERS AND ANSWER CHECKS
# ============================================================

def normalize_text(text):
    """Lowercase, remove punctuation, collapse whitespace."""

    if not text:
        return ""

    text = str(text).lower()
    text = re.sub(r"[^\w\s]", " ", text)

    return re.sub(r"\s+", " ", text).strip()


SUMMARY_FIELDS = {
    "overview", "description", "route_to_market",
    "vertical_market", "deployment_type"
}

STOPWORDS = {
    "the", "and", "for", "with", "that", "this", "from", "are",
    "was", "were", "has", "have", "its", "their", "into", "using",
    "used", "also", "such", "can", "will", "which", "other", "more"
}


def answer_is_grounded(answer, source_text, field_name):
    """
    The answer may only contain facts that exist in the source.

    - every number must appear in the source
    - 60% of the answer words (40% for summary fields) must appear
    """

    source_norm = normalize_text(source_text)
    source_compact = source_norm.replace(" ", "")
    source_words = set(source_norm.split())

    for number in re.findall(r"\d[\d,.]*", str(answer)):

        digits = re.sub(r"[^0-9]", "", number)

        if digits and digits not in source_compact:
            return False

    words = [
        word for word in normalize_text(answer).split()
        if len(word) >= 3 and word not in STOPWORDS
    ]

    if not words:
        return True

    found = sum(1 for word in words if word in source_words)

    threshold = 0.4 if field_name in SUMMARY_FIELDS else 0.6

    return found / len(words) >= threshold


def evidence_found(evidence, text):
    """Evidence must come from the passages (punctuation ignored)."""

    evidence_norm = normalize_text(evidence)
    text_norm = normalize_text(text)

    if not evidence_norm or not text_norm:
        return False

    if evidence_norm in text_norm:
        return True

    words = evidence_norm.split()

    if len(words) < 3:
        return False

    text_words = set(text_norm.split())

    return sum(1 for w in words if w in text_words) / len(words) >= 0.85


# ============================================================
# OLLAMA API CALL
# ============================================================

def choose_context_size(messages, num_predict):
    """
    Pick num_ctx from the real prompt length. A fixed 8192 window
    made Ollama silently drop part of the prompt.
    """

    characters = sum(len(message["content"]) for message in messages)

    needed = characters // 3 + num_predict + 512

    for size in (8192, 16384, 32768):
        if needed <= size:
            return size

    print(f"WARNING: very long prompt (~{needed} tokens).")

    return 32768


def call_ollama(
    prompt,
    output_schema,
    num_predict=NUM_PREDICT,
    system_prompt=None
):
    """
    Send a prompt to Ollama and request structured JSON output.
    Retries once with more room if the output was cut off.
    """

    messages = []

    if system_prompt:
        messages.append({"role": "system", "content": system_prompt})

    messages.append({"role": "user", "content": prompt})

    content = ""

    for attempt in range(2):

        payload = {
            "model": MODEL_NAME,
            "messages": messages,
            "stream": False,
            "format": output_schema,
            "think": False,
            "options": {
                "temperature": 0,
                "num_ctx": choose_context_size(messages, num_predict),
                "num_predict": num_predict
            }
        }

        try:

            response = requests.post(
                OLLAMA_URL,
                json=payload,
                timeout=REQUEST_TIMEOUT
            )

            response.raise_for_status()

            response_data = response.json()

        except requests.exceptions.Timeout as error:

            raise TimeoutError(
                "Ollama request timed out. "
                "Increase REQUEST_TIMEOUT."
            ) from error

        except requests.exceptions.RequestException as error:

            raise RuntimeError(
                f"Could not connect to Ollama: {error}"
            ) from error

        if response_data.get("done_reason") == "length" and attempt == 0:

            num_predict = num_predict * 2
            continue

        content = response_data.get("message", {}).get("content", "")

        break

    if not content or not content.strip():
        raise ValueError("Ollama returned an empty response.")

    content = content.strip()
    content = re.sub(r"^```(?:json)?\s*", "", content, flags=re.IGNORECASE)
    content = re.sub(r"\s*```$", "", content)

    try:

        return json.loads(content)

    except json.JSONDecodeError as error:

        raise ValueError(
            f"Ollama did not return valid JSON. "
            f"Response: {content[:500]}"
        ) from error


# ============================================================
# SPLIT THE QUESTIONNAIRE INTO PASSAGES
# ============================================================

MARKER = re.compile(
    r"^-+\s*(slide|page|table)\s*\d+\s*-+$", re.IGNORECASE
)


def split_long_unit(unit, size, overlap):
    """Cut one very long line at sentence boundaries."""

    pieces = []
    start = 0

    while start < len(unit):

        end = min(start + size, len(unit))

        if end < len(unit):

            cut = max(
                unit.rfind(". ", start, end),
                unit.rfind("? ", start, end),
                unit.rfind("; ", start, end),
                unit.rfind(" | ", start, end)
            )

            if cut > start + size // 2:
                end = cut + 1
            else:
                space = unit.rfind(" ", start, end)
                if space > start + size // 2:
                    end = space

        piece = unit[start:end].strip()

        if piece:
            pieces.append(piece)

        if end >= len(unit):
            break

        start = max(end - overlap, start + 1)

    return pieces


def build_windows(text, size=WINDOW_SIZE, overlap=WINDOW_OVERLAP):
    """
    Passages of about `size` characters. "question | answer" rows
    stay together; rows with several merged questions are cut at
    sentence boundaries.
    """

    pieces = []

    for line in str(text).replace("\r", "\n").split("\n"):

        line = line.strip()

        if not line or MARKER.match(line):
            continue

        if len(line) > size:
            pieces.extend(split_long_unit(line, size, overlap))
        else:
            pieces.append(line)

    windows = []
    current = ""

    for piece in pieces:

        if current and len(current) + len(piece) + 1 > size:
            windows.append(current)
            current = piece
        else:
            current = f"{current}\n{piece}" if current else piece

    if current:
        windows.append(current)

    return windows


def hint_matches(hint, text_lower):

    pattern = r"(?<![a-z0-9])" + re.escape(hint.rstrip("*").lower())

    if not hint.endswith("*"):
        pattern += r"(?![a-z0-9])"

    return re.search(pattern, text_lower) is not None


def find_field_windows(windows, field_name, top_k=TOP_WINDOWS_PER_FIELD):
    """Best passages for one field as (score, text) pairs."""

    hints = QUESTIONNAIRE_HINTS.get(field_name, [])

    scored = []

    for index, window in enumerate(windows):

        text_lower = window.lower()

        score = sum(1 for hint in hints if hint_matches(hint, text_lower))

        if score > 0:
            scored.append((score, index, window))

    scored.sort(key=lambda item: (-item[0], item[1]))

    return [(score, window) for score, _, window in scored[:top_k]]


# ============================================================
# EXTRACT ONE FIELD FROM ITS PASSAGES
# ============================================================

FIELD_ANSWER_SCHEMA = {
    "type": "object",
    "properties": {
        "answer": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
    },
    "required": ["answer", "evidence"],
    "additionalProperties": False
}

SYSTEM_PROMPT = """
You extract ONE field from a company questionnaire.

RULES:

1. Use ONLY the supplied passages.
2. Do not use outside knowledge.
3. Never guess or invent. If the passages do not answer the field,
   return null for answer and evidence.
4. The field description and instructions explain what the field
   means. They are NOT data. Never copy words from them into the
   answer unless the same words appear in the passages.
5. Copy names, numbers, currencies and units exactly as written.
6. Questions and answers may be merged in the same text. Take only
   the part that answers THIS field, nothing that answers a
   different question.
7. Keep current technologies separate from planned or target ones,
   and keep that status in the answer.
8. "evidence" must be a short exact excerpt copied from the
   passages that directly supports the answer.
9. Return valid JSON only.
"""


def extract_one_field(
    section,
    field_name,
    definition,
    passages,
    company_name,
    product_name
):
    """Returns (answer, evidence, status)."""

    passages_text = "\n\n".join(
        f"[PASSAGE {number}]\n{window}"
        for number, (_, window) in enumerate(passages, start=1)
    )

    prompt = f"""
COMPANY: {company_name}
PRODUCT: {product_name}

SECTION: {section}
FIELD NAME: {field_name}

FIELD DESCRIPTION:
{definition.get("description", "")}

FIELD INSTRUCTIONS:
{build_instruction(definition)}

PASSAGES:
{passages_text}

Return a JSON object with the keys "answer" and "evidence".
Use null for both when the passages do not answer this field.
"""

    try:

        result = normalize_null_values(
            call_ollama(
                prompt=prompt,
                output_schema=FIELD_ANSWER_SCHEMA,
                num_predict=NUM_PREDICT,
                system_prompt=SYSTEM_PROMPT
            )
        )

    except (ValueError, TimeoutError) as error:

        print(f"  Invalid response for {field_name}: {error}")

        return None, None, "invalid_model_response"

    if not isinstance(result, dict):
        return None, None, "invalid_model_response"

    answer = result.get("answer")
    evidence = result.get("evidence")

    if isinstance(answer, list):
        answer = ", ".join(str(item) for item in answer if item)

    if not isinstance(answer, str) or not answer.strip():
        return None, None, "not_in_questionnaire"

    passages_only = "\n".join(window for _, window in passages)

    if not isinstance(evidence, str) or not evidence_found(
        evidence, passages_only
    ):
        return None, None, "evidence_not_verified"

    if not answer_is_grounded(answer, passages_only, field_name):
        return None, None, "answer_not_grounded"

    return answer.strip(), evidence.strip(), "extracted"


# ============================================================
# QUESTIONNAIRE ANSWER EXTRACTION
# ============================================================

def extract_questionnaire_answers(
    questionnaire_text: str,
    company_name: str,
    product_name: str
):
    """
    Extract company and product information using only the
    questionnaire. Every field is extracted separately from the
    passages that talk about it.

    Returns (OnePagerExtraction, evidence_data).
    evidence_data: {section: {field: {"quote", "source"}}}
    """

    if not questionnaire_text or not questionnaire_text.strip():
        raise ValueError("Questionnaire text is empty.")

    windows = build_windows(questionnaire_text)

    definitions = get_field_definitions()

    print("\n========== QUESTIONNAIRE EXTRACTION ==========")
    print("Model:", MODEL_NAME)
    print("Passages:", len(windows))

    answers = {"company": {}, "product": {}}
    evidence_data = {"company": {}, "product": {}}

    work = [
        (section, field_name, definition)
        for section, fields in definitions.items()
        for field_name, definition in fields.items()
        if field_name not in NAME_FIELDS
    ]

    for number, (section, field_name, definition) in enumerate(
        work, start=1
    ):

        passages = find_field_windows(windows, field_name)

        if not passages:

            print(f"[{number}/{len(work)}] {field_name}: no matching passage")

            answers[section][field_name] = None
            evidence_data[section][field_name] = {
                "quote": None, "source": None
            }

            continue

        answer, evidence, status = extract_one_field(
            section, field_name, definition, passages,
            company_name, product_name
        )

        print(
            f"[{number}/{len(work)}] {field_name}: {status}"
            + (f" -> {answer[:80]}" if answer else "")
        )

        answers[section][field_name] = answer
        evidence_data[section][field_name] = {
            "quote": evidence,
            "source": "questionnaire" if evidence else None
        }

    # User-provided names are authoritative.
    answers["company"]["company_name"] = company_name
    answers["product"]["product_name"] = product_name

    try:

        extracted = OnePagerExtraction.model_validate(answers)

    except Exception as error:

        raise ValueError(
            f"Questionnaire extraction validation failed: {error}"
        ) from error

    return extracted, evidence_data


# ============================================================
# EVIDENCE VERIFICATION
# ============================================================
def verify_questionnaire_evidence(
    questionnaire_text: str,
    evidence_data: dict
):
    """
    Verify that every evidence quotation appears in the original
    questionnaire. Does not modify the answers.
    """

    normalized_questionnaire = normalize_text(questionnaire_text)

    verification_results = {}

    for section_name, fields in evidence_data.items():

        verification_results[section_name] = {}

        if not isinstance(fields, dict):
            continue

        for field_name, evidence in fields.items():

            quote = (
                evidence.get("quote")
                if isinstance(evidence, dict) else None
            )

            if not quote:

                verification_results[section_name][field_name] = {
                    "verified": False,
                    "needs_review": True,
                    "reason": "No supporting quotation found."
                }

                continue

            verified = normalize_text(quote) in normalized_questionnaire

            verification_results[section_name][field_name] = {
                "verified": verified,
                "needs_review": not verified,
                "reason": (
                    "Quotation found in questionnaire."
                    if verified else
                    "Quotation could not be matched exactly. "
                    "Manual review may be required."
                )
            }

    return verification_results


# ============================================================
# MAIN QUESTIONNAIRE EXTRACTION FUNCTION
# ============================================================

def extract_from_questionnaire(
    questionnaire_text: str,
    company_name: str,
    product_name: str,
    return_evidence=False
):
    """
    Default:
        Returns the validated OnePagerExtraction object.

    If return_evidence=True:
        Returns extracted_answers, evidence_data, evidence_verification
    """

    extracted_answers, evidence_data = extract_questionnaire_answers(
        questionnaire_text=questionnaire_text,
        company_name=company_name,
        product_name=product_name
    )

    if not return_evidence:
        return extracted_answers

    evidence_verification = verify_questionnaire_evidence(
        questionnaire_text=questionnaire_text,
        evidence_data=evidence_data
    )

    return extracted_answers, evidence_data, evidence_verification
