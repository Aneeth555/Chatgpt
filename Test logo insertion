 
from pathlib import Path

from pptx import Presentation
from pptx.oxml.ns import qn


# Project paths
BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_FILE = BASE_DIR / "templates" / "company_one_pager_template.pptx"
LOGO_FILE = BASE_DIR / "test_assets" / "test_logo.png"
OUTPUT_FILE = BASE_DIR / "output" / "test_logo_insertion.pptx"


def main():

    # Check required files
    if not TEMPLATE_FILE.exists():
        raise FileNotFoundError(f"Template not found: {TEMPLATE_FILE}")

    if not LOGO_FILE.exists():
        raise FileNotFoundError(f"Logo not found: {LOGO_FILE}")

    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)

    # Load the clean template
    prs = Presentation(str(TEMPLATE_FILE))

    slide = prs.slides[0]

    # Find the first picture placeholder
    target_placeholder = None

    for shape in slide.shapes:

        if (
            shape.is_placeholder
            and shape.placeholder_format.type == 18
        ):
            target_placeholder = shape
            break

    if target_placeholder is None:
        raise ValueError("No picture placeholder found.")

    print("Target placeholder:", target_placeholder.name)
    print("Shape ID:", target_placeholder.shape_id)

    # Add the new logo image to the slide
    image_part, image_rid = slide.part.get_or_add_image_part(
        str(LOGO_FILE)
    )

    # Replace the existing transparent image relationship
    blip = target_placeholder.element.find(
        ".//" + qn("a:blip")
    )

    if blip is None:
        raise ValueError("Picture placeholder has no image element.")

    blip.set(qn("r:embed"), image_rid)

    # Save the test presentation
    prs.save(str(OUTPUT_FILE))

    print("\nLogo replacement completed.")
    print("Output:", OUTPUT_FILE)


if __name__ == "__main__":
    main()
