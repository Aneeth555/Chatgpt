def tokenize(text):
    """
    Convert text into normalized word tokens.
    """

    return re.findall(
        r"[a-z0-9]+(?:[-'][a-z0-9]+)*",
        (text or "").lower()
    )


def calculate_relevance_score(text, field):
    """
    Calculate a keyword-based relevance score.

    Multiword phrases receive more weight than
    individual keywords.
    """

    text_lower = (text or "").lower()

    keywords = FIELD_KEYWORDS.get(
        field,
        [field.replace("_", " ")]
    )

    score = 0
    matched_keywords = []

    for keyword in keywords:

        if " " in keyword or "-" in keyword:

            if keyword in text_lower:
                score += 3
                matched_keywords.append(keyword)

        else:

            pattern = r"\b" + re.escape(keyword) + r"\b"

            if re.search(pattern, text_lower):
                score += 1
                matched_keywords.append(keyword)

    return {
        "score": score,
        "matched_keywords": matched_keywords
    }


def filter_chunks_for_field(
    chunks,
    field,
    top_k=3,
    minimum_score=1
):
    """
    Select the most relevant chunks for one missing field.
    """

    scored_chunks = []

    for chunk in chunks:

        # Prefer the field association created during search
        related_fields = chunk.get("related_fields", [])

        if related_fields and field not in related_fields:
            continue

        relevance = calculate_relevance_score(
            chunk.get("text", ""),
            field
        )

        if relevance["score"] < minimum_score:
            continue

        scored_chunks.append({
            **chunk,
            "relevance_score": relevance["score"],
            "matched_keywords": relevance["matched_keywords"]
        })

    # Highest relevance first
    scored_chunks.sort(
        key=lambda item: item["relevance_score"],
        reverse=True
    )

    return scored_chunks[:top_k]


def filter_chunks_for_missing_fields(
    chunks,
    missing_report,
    top_k=3,
    minimum_score=1
):
    """
    Filter crawled chunks for each missing field.

    Returns evidence grouped by company/product field.
    """

    filtered_results = {}

    for field_info in missing_report.get(
        "all_missing_fields", []
    ):

        section = field_info["section"]
        field = field_info["field"]

        relevant_chunks = filter_chunks_for_field(
            chunks=chunks,
            field=field,
            top_k=top_k,
            minimum_score=minimum_score
        )

        filtered_results[field] = {
            "section": section,
            "description": field_info.get("description", ""),
            "chunks_found": len(relevant_chunks),
            "evidence": relevant_chunks
        }

    return filtered_results
