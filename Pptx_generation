# ============================================================
# 5. LOAD JSON DATA
# ============================================================

def load_json_data():

    if not JSON_FILE.exists():

        raise FileNotFoundError(
            f"JSON file not found: {JSON_FILE}"
        )

    with open(
        JSON_FILE,
        "r",
        encoding="utf-8"
    ) as file:

        data = json.load(file)

    company_data = data.get("company") or {}

    product_data = data.get("product") or {}

    if not isinstance(company_data, dict):

        raise ValueError(
            "The company section must be a JSON object."
        )

    if not isinstance(product_data, dict):

        raise ValueError(
            "The product section must be a JSON object."
        )

    return company_data, product_data


# ============================================================
# 6. FIND TEXT PLACEHOLDER
# ============================================================

def get_placeholder(slide, placeholder_index):

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        if (
            shape.placeholder_format.idx
            == placeholder_index
        ):

            return shape

    print(
        f"WARNING: Text placeholder "
        f"{placeholder_index} not found."
    )

    return None


# ============================================================
# 7. INSERT TEXT OR CLEAR PLACEHOLDER
# ============================================================

def insert_text(slide, placeholder_index, value):

    shape = get_placeholder(
        slide,
        placeholder_index
    )

    if shape is None:
        return

    if not shape.has_text_frame:

        print(
            f"WARNING: Placeholder {placeholder_index} "
            "does not have a text frame."
        )

        return

    text_frame = shape.text_frame

    # --------------------------------------------------------
    # IMPORTANT:
    # Clear existing template example/instructional text
    # BEFORE checking the JSON value.
    # --------------------------------------------------------

    text_frame.clear()

    # --------------------------------------------------------
    # CASE 1: JSON value is null
    # --------------------------------------------------------

    if value is None:

        print(
            f"CLEARED placeholder {placeholder_index}: "
            "JSON value is null."
        )

        return

    # --------------------------------------------------------
    # CASE 2: JSON value is an empty string
    # --------------------------------------------------------

    if isinstance(value, str):

        value = value.strip()

        if not value:

            print(
                f"CLEARED placeholder {placeholder_index}: "
                "JSON value is empty."
            )

            return

    # --------------------------------------------------------
    # CASE 3: JSON contains an actual value
    # --------------------------------------------------------

    paragraph = text_frame.paragraphs[0]

    paragraph.text = str(value).strip()

    # Preserve text-fitting behaviour
    text_frame.auto_size = (
        MSO_AUTO_SIZE.TEXT_TO_FIT_SHAPE
    )

    print(
        f"INSERTED placeholder {placeholder_index}: "
        f"{value}"
    )


