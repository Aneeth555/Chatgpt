# ============================================================
# 10. NORMALISE NAMES FOR LOGO MATCHING
# ============================================================

def normalise_name(value):

    value = str(value).strip().lower()

    value = Path(value).stem

    value = re.sub(
        r"[^a-z0-9]+",
        "",
        value
    )

    return value


# ============================================================
# 11. EXTRACT ENTRIES FROM JSON
# ============================================================

def extract_entries(value):

    if value is None:
        return []

    if isinstance(value, list):

        return [
            item
            for item in value
            if item is not None
        ]

    if isinstance(value, dict):

        return [value]

    if isinstance(value, str):

        value = value.strip()

        if not value:
            return []

        return [
            item.strip()
            for item in re.split(
                r"[,;\n]+",
                value
            )
            if item.strip()
        ]

    return [value]


# ============================================================
# 12. GET NAME FROM AN ENTRY
# ============================================================

def get_entry_name(entry):

    if isinstance(entry, dict):

        name_keys = [
            "name",
            "company_name",
            "partner_name",
            "customer_name",
            "competitor_name",
            "title",
        ]

        for key in name_keys:

            value = entry.get(key)

            if value:

                return str(value).strip()

        return None

    if entry is None:
        return None

    return str(entry).strip()


# ============================================================
# 13. FIND LOGO IMAGE
# ============================================================

def find_logo_image(category, entry):

    folder_name = LOGO_FOLDERS[category]

    folder_path = LOGO_DIR / folder_name

    if not folder_path.exists():

        print(
            f"Logo folder not found: {folder_path}"
        )

        return None

    # --------------------------------------------------------
    # First: check explicit logo_path in JSON
    # --------------------------------------------------------

    if isinstance(entry, dict):

        logo_path = entry.get("logo_path")

        if logo_path:

            candidate = Path(logo_path)

            if not candidate.is_absolute():

                candidate = BASE_DIR / candidate

            if candidate.exists():

                return candidate

    # --------------------------------------------------------
    # Get company / partner / customer name
    # --------------------------------------------------------

    name = get_entry_name(entry)

    if not name:
        return None

    target_name = normalise_name(name)

    # --------------------------------------------------------
    # Match logo filename with JSON name
    # --------------------------------------------------------

    for image_path in sorted(folder_path.iterdir()):

        if not image_path.is_file():
            continue

        if (
            image_path.suffix.lower()
            not in SUPPORTED_IMAGE_EXTENSIONS
        ):
            continue

        file_name = normalise_name(
            image_path.name
        )

        if file_name == target_name:

            return image_path

    print(
        f"Logo not found for: {name}"
    )

    return None


# ============================================================
# 14. FIND PICTURE PLACEHOLDER
# ============================================================

def get_picture_placeholder(slide, placeholder_index):

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        if (
            shape.placeholder_format.idx
            == placeholder_index
            and shape.placeholder_format.type == 18
        ):

            return shape

    print(
        f"WARNING: Picture placeholder "
        f"{placeholder_index} not found."
    )

    return None


# ============================================================
# 15. INSERT LOGO INTO PICTURE PLACEHOLDER
# ============================================================

def insert_logo(slide, placeholder_index, logo_path):

    if logo_path is None:

        print(
            f"Picture placeholder {placeholder_index} "
            "left empty."
        )

        return

    if not logo_path.exists():

        print(
            f"Logo file does not exist: {logo_path}"
        )

        return

    target_placeholder = get_picture_placeholder(
        slide,
        placeholder_index
    )

    if target_placeholder is None:
        return

    # Use the tested image replacement technique
    image_part, image_rid = (
        slide.part.get_or_add_image_part(
            str(logo_path)
        )
    )

    blip = target_placeholder.element.find(
        ".//" + qn("a:blip")
    )

    if blip is None:

        print(
            f"WARNING: Picture placeholder "
            f"{placeholder_index} has no image element."
        )

        return

    # Replace the transparent image relationship
    blip.set(
        qn("r:embed"),
        image_rid
    )

    print(
        f"Inserted logo into placeholder "
        f"{placeholder_index}: {logo_path.name}"
    )


# ============================================================
# 16. INSERT COMPANY LOGO
# ============================================================

def insert_company_logo(slide, company_data):

    print(
        "\n========== COMPANY LOGO =========="
    )

    company_name = company_data.get(
        "company_name"
    )

    if not company_name:

        print(
            "Company name is empty. "
            "Company logo placeholder remains empty."
        )

        return

    logo_path = find_logo_image(
        "company_logo",
        company_name
    )

    insert_logo(
        slide,
        PICTURE_PLACEHOLDERS["company_logo"],
        logo_path
    )


# ============================================================
# 17. INSERT CATEGORY LOGOS
# ============================================================

def insert_category_logos(
    slide,
    company_data,
    category
):

    print(
        f"\n========== {category.upper()} LOGOS =========="
    )

    placeholder_indices = (
        PICTURE_PLACEHOLDERS[category]
    )

    entries = extract_entries(
        company_data.get(category)
    )

    # Only the first four JSON entries
    entries = entries[:4]

    for position, placeholder_index in enumerate(
        placeholder_indices
    ):

        # No corresponding JSON entry:
        # leave the placeholder empty.
        if position >= len(entries):

            insert_logo(
                slide,
                placeholder_index,
                None
            )

            continue

        entry = entries[position]

        logo_path = find_logo_image(
            category,
            entry
        )

        insert_logo(
            slide,
            placeholder_index,
            logo_path
        )


# ============================================================
# 18. INSERT ALL LOGOS
# ============================================================

def insert_all_logos(slide, company_data):

    print(
        "\n========== LOGO INSERTION =========="
    )

    insert_company_logo(
        slide,
        company_data
    )

    insert_category_logos(
        slide,
        company_data,
        "gtm_partners"
    )

    insert_category_logos(
        slide,
        company_data,
        "key_customers"
    )

    insert_category_logos(
        slide,
        company_data,
        "competitors"
    )


# ============================================================
# 19. GENERATE POWERPOINT
# ============================================================

def generate_presentation():

    print("\n========================================")
    print("       ONE-PAGER GENERATOR")
    print("========================================")

    # --------------------------------------------------------
    # Check template
    # --------------------------------------------------------

    if not TEMPLATE_FILE.exists():

        raise FileNotFoundError(
            f"Template not found: {TEMPLATE_FILE}"
        )

    # --------------------------------------------------------
    # Check JSON
    # --------------------------------------------------------

    if not JSON_FILE.exists():

        raise FileNotFoundError(
            f"JSON file not found: {JSON_FILE}"
        )

    # --------------------------------------------------------
    # Check logo folder
    # --------------------------------------------------------

    if not LOGO_DIR.exists():

        print(
            f"WARNING: Logo directory not found: {LOGO_DIR}"
        )

        print(
            "PowerPoint will be generated without logos."
        )

    # --------------------------------------------------------
    # Load JSON
    # --------------------------------------------------------

    company_data, product_data = load_json_data()

    # --------------------------------------------------------
    # Load clean template
    # --------------------------------------------------------

    presentation = Presentation(
        str(TEMPLATE_FILE)
    )

    if len(presentation.slides) == 0:

        raise ValueError(
            "The PowerPoint template contains no slides."
        )

    slide = presentation.slides[0]

    # --------------------------------------------------------
    # Insert company information
    # --------------------------------------------------------

    insert_company_information(
        slide,
        company_data
    )

    # --------------------------------------------------------
    # Insert product information
    # --------------------------------------------------------

    insert_product_information(
        slide,
        product_data
    )

    # --------------------------------------------------------
    # Insert logos
    # --------------------------------------------------------

    insert_all_logos(
        slide,
        company_data
    )

    # --------------------------------------------------------
    # Create output directory
    # --------------------------------------------------------

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    # --------------------------------------------------------
    # Save editable PowerPoint
    # --------------------------------------------------------

    presentation.save(
        str(OUTPUT_FILE)
    )

    print("\n========================================")
    print("  POWERPOINT GENERATION COMPLETED")
    print("========================================")

    print(
        "\nOutput file:"
    )

    print(OUTPUT_FILE)


# ============================================================
# 20. MAIN
# ============================================================

if __name__ == "__main__":

    generate_presentation()
