
import asyncio
from crawl4ai import (
    AsyncWebCrawler,
    BrowserConfig,
    CrawlerRunConfig,
    CacheMode
)


def extract_markdown(result):
    """
    Handle different Crawl4AI markdown response formats.
    """

    markdown = getattr(result, "markdown", None)

    if isinstance(markdown, str):
        return markdown

    if markdown is not None:
        return (
            getattr(markdown, "fit_markdown", None)
            or getattr(markdown, "raw_markdown", None)
            or ""
        )

    return ""


async def crawl_single_url(crawler, url):
    """
    Crawl one webpage and extract its readable content.
    """

    try:
        result = await crawler.arun(
            url=url
        )

        if not result.success:
            return {
                "url": url,
                "success": False,
                "error": getattr(result, "error_message", "Crawling failed"),
                "content": ""
            }

        content = extract_markdown(result)

        return {
            "url": url,
            "final_url": getattr(result, "url", url),
            "success": True,
            "content": content
        }

    except Exception as error:

        return {
            "url": url,
            "success": False,
            "error": str(error),
            "content": ""
        }


async def crawl_webpages(search_results):
    """
    Crawl unique URLs from the DDGS search results.

    Maintains the association between each webpage
    and the missing fields it may help answer.
    """

    unique_pages = {}

    # Collect URLs and their associated fields
    for field, field_data in search_results.items():

        for item in field_data.get("results", []):

            url = item.get("url")

            if not url:
                continue

            if url not in unique_pages:

                unique_pages[url] = {
                    "title": item.get("title", ""),
                    "url": url,
                    "domain": item.get("domain", ""),
                    "snippet": item.get("snippet", ""),
                    "related_fields": []
                }

            if field not in unique_pages[url]["related_fields"]:
                unique_pages[url]["related_fields"].append(field)

    print("\nUnique URLs to crawl:", len(unique_pages))

    browser_config = BrowserConfig(
        headless=True,
        verbose=False
    )

    run_config = CrawlerRunConfig(
        cache_mode=CacheMode.BYPASS,
        word_count_threshold=30,
        page_timeout=60000
    )

    crawled_pages = []

    async with AsyncWebCrawler(config=browser_config) as crawler:

        for index, page in enumerate(
            unique_pages.values(), start=1
        ):

            print(
                f"\n[{index}/{len(unique_pages)}] Crawling:"
            )
            print(page["url"])

            crawl_result = await crawl_single_url(
                crawler,
                page["url"]
            )

            page.update(crawl_result)

            content = page.get("content", "")

            page["content_length"] = len(content)

            print("Success:", page["success"])
            print("Content characters:", len(content))

            crawled_pages.append(page)

    return crawled_pages


def crawl_search_results(search_results):
    """
    Synchronous entry point for the crawler.
    """

    return asyncio.run(
        crawl_webpages(search_results)
    )
