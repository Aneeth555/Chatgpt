from schemas.field_definitions import (
    get_field_definitions,
    get_all_field_names
)


definitions = get_field_definitions()

field_names = get_all_field_names()

print("\n========== FIELD DEFINITIONS ==========")

for section, fields in definitions.items():

    print(f"\n{section.upper()}")

    for field_name, details in fields.items():

        print(f"\nField: {field_name}")
        print(f"Meaning: {details['description']}")

print("\n========== FIELD COUNTS ==========")

for section, fields in field_names.items():
    print(f"{section}: {len(fields)} fields")

total_fields = sum(len(fields) for fields in field_names.values())

print(f"\nTotal fields: {total_fields}")
