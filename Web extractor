 import json
import re
import requests

from llm.ollama_client import MODEL_NAME

from schemas.field_definitions import (
    get_field_definitions
)


# ============================================================
# OLLAMA CONFIGURATION
# ============================================================

OLLAMA_URL = "http://localhost:11434/api/chat"

REQUEST_TIMEOUT = 300

MAX_CHUNK_CHARACTERS = 2500

NUM_CTX = 8192
NUM_PREDICT = 512


# ============================================================
# LOAD SHARED FIELD DEFINITIONS
# ============================================================

FIELD_DEFINITIONS = get_field_definitions()


# ============================================================
# NORMALIZE FIELD NAME
# ============================================================

def normalize_field_name(name):
    """
    Normalize field names to support minor differences
    in spaces, hyphens and underscores.
    """

    return re.sub(
        r"[\s\-]+",
        "_",
        str(name).strip().lower()
    )


# ============================================================
# GET FIELD DEFINITION
# ============================================================

def get_field_definition(section, field_name):
    """
    Retrieve the complete shared definition of a field.

    Returns all six properties:
        display_name
        description
        what_to_extract
        what_not_to_extract
        answer_format
        source_guidance
    """

    section_definitions = FIELD_DEFINITIONS.get(
        section,
        {}
    )

    normalized_name = normalize_field_name(field_name)

    for defined_name, definition in section_definitions.items():

        if normalize_field_name(defined_name) == normalized_name:

            return {
                "display_name": definition.get(
                    "display_name", defined_name
                ),

                "description": definition.get(
                    "description", ""
                ),

                "what_to_extract": definition.get(
                    "what_to_extract", ""
                ),

                "what_not_to_extract": definition.get(
                    "what_not_to_extract", ""
                ),

                "answer_format": definition.get(
                    "answer_format", ""
                ),

                "source_guidance": definition.get(
                    "source_guidance", ""
                )
            }

    return None


# ============================================================
# JSON RESPONSE FORMAT
# ============================================================

WEB_ANSWER_FORMAT = {
    "type": "object",

    "properties": {

        "answer": {
            "type": ["string", "null"]
        },

        "evidence": {
            "type": ["string", "null"]
        },

        "source_id": {
            "type": ["string", "null"]
        }
    },

    "required": [
        "answer",
        "evidence",
        "source_id"
    ],

    "additionalProperties": False
}


# ============================================================
# PREPARE EVIDENCE FOR ONE FIELD
# ============================================================

def prepare_field_evidence(evidence_chunks):
    """
    Prepare webpage evidence and assign source IDs.
    """

    sources = []

    evidence_text = []

    for index, chunk in enumerate(evidence_chunks, start=1):

        source_id = f"S{index}"

        source = {
            "source_id": source_id,
            "title": chunk.get("title", ""),
            "url": chunk.get("url", ""),
            "domain": chunk.get("domain", "")
        }

        sources.append(source)

        text = chunk.get("text", "")

        text = text[:MAX_CHUNK_CHARACTERS]

        evidence_text.append(
            f"""
[SOURCE {source_id}]
Title: {source['title']}
URL: {source['url']}
Domain: {source['domain']}
Content:
{text}
"""
        )

    return "\n".join(evidence_text), sources


# ============================================================
# EXTRACT ONE FIELD USING QWEN
# ============================================================

def extract_single_field(
    field_name,
    section,
    field_definition,
    evidence_chunks
):
    """
    Extract one field using all six shared field-definition
    properties and supplied webpage evidence.
    """

    if not evidence_chunks:

        return {
            "answer": None,
            "evidence": None,
            "source_url": None,
            "status": "no_relevant_evidence"
        }

    evidence_text, sources = prepare_field_evidence(
        evidence_chunks
    )

    source_ids = {
        source["source_id"]: source
        for source in sources
    }

    # --------------------------------------------------------
    # GET ALL SIX FIELD-DEFINITION PROPERTIES
    # --------------------------------------------------------

    display_name = field_definition.get(
        "display_name", field_name
    )

    description = field_definition.get(
        "description", ""
    )

    what_to_extract = field_definition.get(
        "what_to_extract", ""
    )

    what_not_to_extract = field_definition.get(
        "what_not_to_extract", ""
    )

    answer_format = field_definition.get(
        "answer_format", ""
    )

    source_guidance = field_definition.get(
        "source_guidance", ""
    )

    # --------------------------------------------------------
    # SYSTEM PROMPT
    # --------------------------------------------------------

    system_prompt = """
You are a factual information extraction assistant.

Your task is to extract information for a specific
company or product field using ONLY the supplied
webpage evidence.

You must understand the meaning of the requested field
before extracting an answer.

STRICT RULES:

1. Use only the supplied webpage evidence.

2. Follow ALL six field-definition properties.

3. Do not use outside knowledge or previously learned facts.

4. Do not guess, assume or invent information.

5. Do not confuse similar fields.

6. Extract only information that answers the requested field.

7. If evidence does not support an answer, return null.

8. Preserve the original meaning and important details.

9. Do not convert ranges into exact numerical values.

10. Do not invent currencies, dates, units or specifications.

11. Preserve technical names, model names and version numbers.

12. Distinguish current implementations from planned
    technologies and future targets.

13. Follow the field's exclusions carefully.

14. Evidence must be an exact quotation or short excerpt
    from the supplied webpage content.

15. Select only one source that directly supports the answer.

16. Never invent a source ID.

17. Do not interpret navigation links, unrelated numbers,
    page metadata or profile counts as factual answers.

18. Return valid JSON only.

IMPORTANT:

A keyword appearing in a webpage does not automatically
mean that it answers the requested field.

Understand the context and relationship between the
information and the requested field before extracting it.

If multiple pieces of information support the same field,
combine them only when they are relevant and supported
by the selected source.
"""

    # --------------------------------------------------------
    # USER PROMPT
    # --------------------------------------------------------

    user_prompt = f"""
Extract the requested one-pager field.

============================================================
FIELD INFORMATION
============================================================

SECTION:
{section}

INTERNAL FIELD NAME:
{field_name}

DISPLAY NAME:
{display_name}

DESCRIPTION:
{description}

WHAT TO EXTRACT:
{what_to_extract}

WHAT NOT TO EXTRACT:
{what_not_to_extract}

EXPECTED ANSWER FORMAT:
{answer_format}

SOURCE GUIDANCE:
{source_guidance}

============================================================
AVAILABLE SOURCE IDs
============================================================

{", ".join(source_ids.keys())}

============================================================
WEBPAGE EVIDENCE
============================================================

{evidence_text}

============================================================
EXTRACTION REQUIREMENTS
============================================================

1. Understand what this field represents.

2. Follow the field definition and all its instructions.

3. Examine the context surrounding relevant information.

4. Do not select information merely because it contains
   a similar keyword.

5. Do not confuse company-level and product-level facts.

6. Do not mistake navigation links, profile counts,
   unrelated numbers or page metadata for factual answers.

7. Preserve the original values and technical details.

8. Follow the expected answer format.

9. Use the smallest relevant exact evidence excerpt that
   directly supports the answer.

10. Select the correct source ID associated with the
    supporting quotation.

11. If no evidence supports the requested field,
    return null for answer, evidence and source_id.

Return this JSON structure:

{{
    "answer": null,
    "evidence": null,
    "source_id": null
}}

Return valid JSON only.
"""

    # --------------------------------------------------------
    # OLLAMA REQUEST
    # --------------------------------------------------------

    payload = {

        "model": MODEL_NAME,

        "messages": [
            {
                "role": "system",
                "content": system_prompt
            },
            {
                "role": "user",
                "content": user_prompt
            }
        ],

        "format": WEB_ANSWER_FORMAT,

        "stream": False,

        "think": False,

        "options": {
            "temperature": 0,
            "num_ctx": NUM_CTX,
            "num_predict": NUM_PREDICT
        }
    }

    try:

        response = requests.post(
            OLLAMA_URL,
            json=payload,
            timeout=REQUEST_TIMEOUT
        )

        response.raise_for_status()

        response_data = response.json()

        content = response_data["message"]["content"]

        result = json.loads(content)

        answer = result.get("answer")

        evidence = result.get("evidence")

        source_id = result.get("source_id")

        # ----------------------------------------------------
        # VALIDATE ANSWER
        # ----------------------------------------------------

        if not isinstance(answer, str) or not answer.strip():

            return {
                "answer": None,
                "evidence": None,
                "source_url": None,
                "status": "no_supported_answer"
            }

        # ----------------------------------------------------
        # VALIDATE EVIDENCE
        # ----------------------------------------------------

        if not isinstance(evidence, str) or not evidence.strip():

            return {
                "answer": None,
                "evidence": None,
                "source_url": None,
                "status": "missing_evidence"
            }

        # ----------------------------------------------------
        # VALIDATE SOURCE ID
        # ----------------------------------------------------

        selected_source = source_ids.get(source_id)

        if selected_source is None:

            return {
                "answer": None,
                "evidence": None,
                "source_url": None,
                "status": "invalid_source"
            }

        # ----------------------------------------------------
        # VERIFY EVIDENCE AGAINST ORIGINAL CHUNK
        # ----------------------------------------------------

        source_index = int(source_id[1:]) - 1

        source_text = evidence_chunks[
            source_index
        ].get("text", "")

        normalized_source = " ".join(
            source_text.lower().split()
        )

        normalized_evidence = " ".join(
            evidence.lower().split()
        )

        if normalized_evidence not in normalized_source:

            return {
                "answer": None,
                "evidence": None,
                "source_url": None,
                "status": "evidence_not_verified"
            }

        # ----------------------------------------------------
        # RETURN VERIFIED EXTRACTION
        # ----------------------------------------------------

        return {

            "answer": answer.strip(),

            "evidence": evidence.strip(),

            "source_url": selected_source["url"],

            "source_title": selected_source["title"],

            "status": "extracted"
        }

    except requests.exceptions.ConnectionError:

        raise RuntimeError(
            "Could not connect to Ollama. "
            "Check whether Ollama is running."
        )

    except requests.exceptions.Timeout:

        raise RuntimeError(
            f"Ollama timed out while extracting {field_name}."
        )

    except (
        ValueError,
        KeyError,
        TypeError,
        IndexError
    ) as error:

        print(
            f"Invalid response while extracting {field_name}: "
            f"{error}"
        )

        return {
            "answer": None,
            "evidence": None,
            "source_url": None,
            "status": "invalid_model_response"
        }

# ============================================================
# EXTRACT ALL MISSING FIELDS
# ============================================================

def extract_from_web(filtered_evidence):
    """
    Extract all missing fields using shared field definitions.

    Each field is processed separately.

    Qwen receives all six properties from field_definitions.py.
    """

    web_results = {}

    total_fields = len(filtered_evidence)

    print("\n========== QWEN WEB EXTRACTION ==========")

    for index, (field_name, field_data) in enumerate(
        filtered_evidence.items(),
        start=1
    ):

        section = field_data.get("section", "")

        evidence_chunks = field_data.get("evidence", [])

        print(
            f"\n[{index}/{total_fields}] "
            f"Extracting: {field_name}"
        )

        print("Section:", section)

        print("Relevant chunks:", len(evidence_chunks))

        # ----------------------------------------------------
        # GET COMPLETE SHARED FIELD DEFINITION
        # ----------------------------------------------------

        definition = get_field_definition(
            section=section,
            field_name=field_name
        )

        if definition is None:

            print("Status: field_definition_not_found")

            web_results[field_name] = {
                "section": section,
                "answer": None,
                "evidence": None,
                "source_url": None,
                "status": "field_definition_not_found"
            }

            continue

        # ----------------------------------------------------
        # CALL QWEN
        # ----------------------------------------------------

        try:

            result = extract_single_field(
                field_name=field_name,
                section=section,
                field_definition=definition,
                evidence_chunks=evidence_chunks
            )

        except RuntimeError:
            raise

        web_results[field_name] = {
            "section": section,
            **result
        }

        # ----------------------------------------------------
        # DISPLAY EXTRACTION RESULT
        # ----------------------------------------------------

        print("Status:", result["status"])

        print("Answer:", result["answer"])

        if result.get("source_url"):

            print("Source:", result["source_url"])

        if result.get("evidence"):

            print("Evidence:", result["evidence"])

    print("\n========== WEB EXTRACTION COMPLETED ==========")

    print("Total fields processed:", total_fields)

    successful = sum(
        1
        for result in web_results.values()
        if result.get("status") == "extracted"
    )

    print("Successfully extracted:", successful)

    print(
        "Not extracted:",
        total_fields - successful
    )

    return web_results
