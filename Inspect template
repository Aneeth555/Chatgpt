 
from pathlib import Path

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER


# ==================================================
# 1. PROJECT PATHS
# ==================================================

BASE_DIR = Path(__file__).resolve().parent.parent

ORIGINAL_FILE = (
    BASE_DIR / "templates" / "original_one_pager.pptx"
)

CLEAN_FILE = (
    BASE_DIR / "templates" / "company_one_pager_template.pptx"
)

REPORT_FILE = (
    BASE_DIR / "output" / "template_inspection.txt"
)


# ==================================================
# 2. TARGET PLACEHOLDERS
# ==================================================

TARGET_INDICES = [79, 80, 86, 87]


# ==================================================
# 3. FONT INFORMATION
# ==================================================

def get_color(font):

    try:
        if font.color.type is None:
            return "Inherited"

        if font.color.rgb:
            return str(font.color.rgb)

        return f"Theme: {font.color.theme_color}"

    except Exception:
        return "Inherited"


def inspect_font(run, report):

    font = run.font

    report.write(f"      Text: {run.text!r}\n")
    report.write(f"      Font: {font.name}\n")

    report.write(
        f"      Size: "
        f"{font.size.pt if font.size else 'Inherited'}\n"
    )

    report.write(f"      Bold: {font.bold}\n")
    report.write(f"      Italic: {font.italic}\n")
    report.write(f"      Color: {get_color(font)}\n")


# ==================================================
# 4. INSPECT ALL SLIDE SHAPES
# ==================================================

def inspect_shapes(presentation, report):

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        report.write(
            f"\n========== SLIDE {slide_number} ==========\n"
        )

        for index, shape in enumerate(slide.shapes):

            report.write("\n" + "-" * 55 + "\n")

            report.write(f"Collection index: {index}\n")
            report.write(f"Shape ID: {shape.shape_id}\n")
            report.write(f"Shape name: {shape.name}\n")
            report.write(f"Shape type: {shape.shape_type}\n")

            report.write(f"Left: {shape.left}\n")
            report.write(f"Top: {shape.top}\n")
            report.write(f"Width: {shape.width}\n")
            report.write(f"Height: {shape.height}\n")

            if shape.is_placeholder:

                report.write("Placeholder: YES\n")

                report.write(
                    f"Placeholder type: "
                    f"{shape.placeholder_format.type}\n"
                )

                report.write(
                    f"Placeholder index: "
                    f"{shape.placeholder_format.idx}\n"
                )

                if (
                    shape.placeholder_format.type
                    == PP_PLACEHOLDER.PICTURE
                ):
                    report.write("Category: PICTURE\n")

                else:
                    report.write("Category: TEXT / OTHER\n")

            else:
                report.write("Placeholder: NO\n")

            if shape.has_text_frame:

                report.write(f"Text: {shape.text!r}\n")

                for p_index, paragraph in enumerate(
                    shape.text_frame.paragraphs
                ):

                    report.write(
                        f"  Paragraph: {p_index}\n"
                    )

                    report.write(
                        f"  Alignment: {paragraph.alignment}\n"
                    )

                    for run in paragraph.runs:
                        inspect_font(run, report)


# ==================================================
# 5. INSPECT LAYOUT PLACEHOLDERS
# ==================================================

def inspect_layouts(presentation, report):

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        report.write(
            f"\n========== SLIDE {slide_number} LAYOUT ==========\n"
        )

        for shape in slide.slide_layout.shapes:

            if not shape.is_placeholder:
                continue

            report.write("\nLAYOUT PLACEHOLDER\n")
            report.write(f"Name: {shape.name}\n")
            report.write(f"ID: {shape.shape_id}\n")

            report.write(
                f"Type: {shape.placeholder_format.type}\n"
            )

            report.write(
                f"Index: {shape.placeholder_format.idx}\n"
            )

            report.write(f"Left: {shape.left}\n")
            report.write(f"Top: {shape.top}\n")
            report.write(f"Width: {shape.width}\n")
            report.write(f"Height: {shape.height}\n")

            if shape.has_text_frame:
                report.write(f"Text: {shape.text!r}\n")


# ==================================================
# 6. INSPECT SELECTED PLACEHOLDERS
# ==================================================

def inspect_target_placeholders():

    presentation = Presentation(str(CLEAN_FILE))
    slide = presentation.slides[0]

    print("\n========================================")
    print("TARGET PLACEHOLDER INSPECTION")
    print("========================================")

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        placeholder_index = (
            shape.placeholder_format.idx
        )

        if placeholder_index not in TARGET_INDICES:
            continue

        print("\n----------------------------------------")

        print("Placeholder index:", placeholder_index)
        print("Shape ID:", shape.shape_id)
        print("Shape name:", shape.name)

        print("Text:", repr(shape.text))

        print("Left:", shape.left)
        print("Top:", shape.top)
        print("Width:", shape.width)
        print("Height:", shape.height)

        print(
            "Number of paragraphs:",
            len(shape.text_frame.paragraphs)
        )

        print(
            "Vertical anchor:",
            shape.text_frame.vertical_anchor
        )

        print(
            "Word wrap:",
            shape.text_frame.word_wrap
        )

        print(
            "Auto size:",
            shape.text_frame.auto_size
        )

        for i, paragraph in enumerate(
            shape.text_frame.paragraphs
        ):

            print("\nParagraph:", i)

            print(
                "Alignment:",
                paragraph.alignment
            )

            print(
                "Run count:",
                len(paragraph.runs)
            )

            for run in paragraph.runs:

                print("Run text:", repr(run.text))
                print("Font name:", run.font.name)

                print(
                    "Font size:",
                    run.font.size.pt
                    if run.font.size else None
                )

                print("Bold:", run.font.bold)
                print("Color:", get_color(run.font))


# ==================================================
# 7. SAVE COMPLETE REPORT
# ==================================================

def inspect_presentation(file_path, name, report):

    report.write("\n" + "=" * 70 + "\n")
    report.write(f"TEMPLATE: {name}\n")
    report.write(f"FILE: {file_path}\n")
    report.write("=" * 70 + "\n")

    if not file_path.exists():

        report.write("ERROR: File not found.\n")
        return

    presentation = Presentation(str(file_path))

    report.write(
        f"Slide width: {presentation.slide_width}\n"
    )

    report.write(
        f"Slide height: {presentation.slide_height}\n"
    )

    inspect_shapes(presentation, report)
    inspect_layouts(presentation, report)


# ==================================================
# 8. MAIN FUNCTION
# ==================================================

def main():

    REPORT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    with open(
        REPORT_FILE,
        "w",
        encoding="utf-8"
    ) as report:

        report.write(
            "ONE-PAGER TEMPLATE INSPECTION REPORT\n"
        )

        inspect_presentation(
            ORIGINAL_FILE,
            "ORIGINAL TEMPLATE",
            report
        )

        inspect_presentation(
            CLEAN_FILE,
            "CLEAN TEMPLATE",
            report
        )

    print("\nComplete inspection report saved:")
    print(REPORT_FILE)

    if CLEAN_FILE.exists():

        inspect_target_placeholders()


if __name__ == "__main__":
    main()
