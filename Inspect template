from pathlib import Path

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER
from pptx.oxml.ns import qn


# Project directory
BASE_DIR = Path(__file__).resolve().parent.parent

# Clean template
INPUT_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)
def inspect_picture_placeholders(presentation):

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\n========== SLIDE {slide_number} ==========")

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if shape.placeholder_format.type != PP_PLACEHOLDER.PICTURE:
                continue

            print("\nPICTURE PLACEHOLDER:", shape.name)

            # Slide placeholder information
            slide_type = shape.placeholder_format.type
            slide_index = shape.placeholder_format.idx
            slide_blips = shape._element.xpath(".//a:blip")

            print("Slide placeholder type:", slide_type)
            print("Slide placeholder index:", slide_index)
            print("Slide shape type:", shape.shape_type)
            print("Slide image references:", len(slide_blips))

            for blip in slide_blips:
                print(
                    "Slide embedded ID:",
                    blip.get(qn("r:embed"))
                )

            # Find matching layout placeholder
            matching_layout = None

            for layout_shape in slide.slide_layout.shapes:

                if not layout_shape.is_placeholder:
                    continue

                if (
                    layout_shape.placeholder_format.type
                    != PP_PLACEHOLDER.PICTURE
                ):
                    continue

                if (
                    layout_shape.placeholder_format.idx
                    == slide_index
                ):
                    matching_layout = layout_shape
                    break

            if matching_layout is None:
                print("Matching layout placeholder: NOT FOUND")
                continue

            layout_type = matching_layout.placeholder_format.type
            layout_index = matching_layout.placeholder_format.idx

            layout_blips = (
                matching_layout._element.xpath(".//a:blip")
            )

            print("\nMatching layout placeholder:", matching_layout.name)
            print("Layout placeholder type:", layout_type)
            print("Layout placeholder index:", layout_index)
            print("Layout shape type:", matching_layout.shape_type)
            print("Layout image references:", len(layout_blips))

            for blip in layout_blips:
                print(
                    "Layout embedded ID:",
                    blip.get(qn("r:embed"))
                )
def inspect_text_placeholders(presentation):

    print("\n========== TEXT PLACEHOLDERS ==========")

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\nSLIDE {slide_number}")

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if not shape.has_text_frame:
                continue

            if (
                shape.placeholder_format.type
                == PP_PLACEHOLDER.PICTURE
            ):
                continue

            print("\nShape:", shape.name)
            print("Text:", repr(shape.text))
            print(
                "Placeholder type:",
                shape.placeholder_format.type
            )
def inspect_embedded_images():

    import zipfile

    print("\n========== EMBEDDED IMAGE FILES ==========")

    with zipfile.ZipFile(INPUT_FILE, "r") as pptx_file:

        image_files = [
            name for name in pptx_file.namelist()
            if name.startswith("ppt/media/")
        ]

        if not image_files:
            print("No embedded image files found.")
        else:
            for image_file in image_files:
                print(image_file)

        print("\nTotal embedded image files:", len(image_files))


def main():

    if not INPUT_FILE.exists():
        print("ERROR: Clean template not found.")
        print(INPUT_FILE)
        return

    presentation = Presentation(str(INPUT_FILE))

    print("CLEAN TEMPLATE INSPECTION")
    print("File:", INPUT_FILE)

    inspect_picture_placeholders(presentation)

    inspect_text_placeholders(presentation)

    inspect_embedded_images()

    print("\n========== INSPECTION COMPLETED ==========")


if __name__ == "__main__":
    main()
