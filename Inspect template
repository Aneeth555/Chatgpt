 
from pathlib import Path
from pptx import Presentation

BASE_DIR = Path(__file__).resolve().parent.parent

INPUT_FILE = BASE_DIR / "templates" / "original_one_pager.pptx"

prs = Presentation(str(INPUT_FILE))


def inspect_shapes(shapes, location):

    print(f"\n===== {location} =====")

    for i, shape in enumerate(shapes):

        print(f"\nShape index: {i}")
        print("Name:", shape.name)
        print("Type:", shape.shape_type)

        print(
            "Position:",
            shape.left,
            shape.top,
            shape.width,
            shape.height
        )

        if shape.is_placeholder:

            print(
                "Placeholder type:",
                shape.placeholder_format.type
            )

        if shape.shape_type == 13:
            print("ACTUAL PICTURE FOUND")

        if shape.has_text_frame and shape.text.strip():
            print("Text:", repr(shape.text))


for slide_number, slide in enumerate(prs.slides, start=1):

    inspect_shapes(
        slide.shapes,
        f"SLIDE {slide_number}"
    )

    inspect_shapes(
        slide.slide_layout.shapes,
        f"SLIDE {slide_number} LAYOUT"
    )

    inspect_shapes(
        slide.slide_layout.slide_master.shapes,
        f"SLIDE {slide_number} MASTER"
    )
