 from pathlib import Path
import zipfile

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER


BASE_DIR = Path(__file__).resolve().parent.parent

INPUT_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)
def inspect_picture_placeholders(presentation):

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\n========== SLIDE {slide_number} ==========")

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if (
                shape.placeholder_format.type
                != PP_PLACEHOLDER.PICTURE
            ):
                continue

            print("\nPICTURE PLACEHOLDER:", shape.name)

            slide_index = shape.placeholder_format.idx
            slide_blips = shape._element.xpath(".//a:blip")

            print(
                "Slide placeholder type:",
                shape.placeholder_format.type
            )
            print("Slide placeholder index:", slide_index)
            print("Slide shape type:", shape.shape_type)
            print("Slide image references:", len(slide_blips))

            matching_layout = None

            for layout_shape in slide.slide_layout.shapes:

                if not layout_shape.is_placeholder:
                    continue

                if (
                    layout_shape.placeholder_format.type
                    != PP_PLACEHOLDER.PICTURE
                ):
                    continue

                if (
                    layout_shape.placeholder_format.idx
                    == slide_index
                ):
                    matching_layout = layout_shape
                    break

            if matching_layout is None:
                print("Matching layout placeholder: NOT FOUND")
                continue

            layout_blips = (
                matching_layout._element.xpath(".//a:blip")
            )

            print(
                "Matching layout placeholder:",
                matching_layout.name
            )
            print(
                "Layout placeholder type:",
                matching_layout.placeholder_format.type
            )
            print(
                "Layout placeholder index:",
                matching_layout.placeholder_format.idx
            )
            print(
                "Layout shape type:",
                matching_layout.shape_type
            )
            print(
                "Layout image references:",
                len(layout_blips)
            )
def inspect_text_placeholders(presentation):

    print("\n========== TEXT PLACEHOLDERS ==========")

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\nSLIDE {slide_number}")

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if not shape.has_text_frame:
                continue

            if (
                shape.placeholder_format.type
                == PP_PLACEHOLDER.PICTURE
            ):
                continue

            print("\nShape:", shape.name)
            print("Text:", repr(shape.text))
            print(
                "Placeholder type:",
                shape.placeholder_format.type
def inspect_placeholder_fill(presentation):

    print("\n========== PLACEHOLDER FILL INSPECTION ==========")

    for slide in presentation.slides:

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if (
                shape.placeholder_format.type
                != PP_PLACEHOLDER.PICTURE
            ):
                continue

            print("\nPlaceholder:", shape.name)

            element = shape._element

            print(
                "Slide has blipFill:",
                len(element.xpath(".//a:blipFill"))
            )

            print(
                "Slide has solidFill:",
                len(element.xpath(".//a:solidFill"))
            )

            print(
                "Slide has noFill:",
                len(element.xpath(".//a:noFill"))
            )

            layout_shape = None

            for candidate in shape.part.slide_layout.shapes:

                if not candidate.is_placeholder:
                    continue

                if (
                    candidate.placeholder_format.type
                    != PP_PLACEHOLDER.PICTURE
                ):
                    continue

                if (
                    candidate.placeholder_format.idx
                    == shape.placeholder_format.idx
                ):
                    layout_shape = candidate
                    break

            if layout_shape is not None:

                layout_element = layout_shape._element

                print(
                    "Layout has blipFill:",
                    len(layout_element.xpath(".//a:blipFill"))
                )

                print(
                    "Layout has solidFill:",
                    len(layout_element.xpath(".//a:solidFill"))
                )

                print(
                    "Layout has noFill:",
                    len(layout_element.xpath(".//a:noFill"))
                )
def inspect_embedded_images():

    print("\n========== EMBEDDED IMAGE FILES ==========")

    with zipfile.ZipFile(INPUT_FILE, "r") as pptx_file:

        image_files = [
            name
            for name in pptx_file.namelist()
            if name.startswith("ppt/media/")
        ]

        if not image_files:
            print("No embedded image files found.")

        else:
            for image_file in image_files:
                print(image_file)

        print(
            "\nTotal embedded image files:",
            len(image_files)
        )
def main():

    if not INPUT_FILE.exists():

        print("ERROR: Clean template not found.")
        print(INPUT_FILE)
        return

    presentation = Presentation(str(INPUT_FILE))

    print("CLEAN TEMPLATE INSPECTION")
    print("File:", INPUT_FILE)

    # 1. Picture placeholder inspection
    inspect_picture_placeholders(presentation)

    # 2. Text placeholder inspection
    inspect_text_placeholders(presentation)

    # 3. Picture fill inspection
    inspect_placeholder_fill(presentation)

    # 4. Embedded image inspection
    inspect_embedded_images()

    print("\n========== INSPECTION COMPLETED ==========")


if __name__ == "__main__":
    main()

