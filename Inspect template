 
from pathlib import Path

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER
from pptx.dml.color import RGBColor


BASE_DIR = Path(__file__).resolve().parent.parent

ORIGINAL_FILE = BASE_DIR / "templates" / "original_one_pager.pptx"
CLEAN_FILE = BASE_DIR / "templates" / "company_one_pager_template.pptx"


def get_color(font):

    try:
        if font.color.type is None:
            return None

        if font.color.rgb:
            return str(font.color.rgb)

        return f"Theme color: {font.color.theme_color}"

    except (AttributeError, TypeError, ValueError):
        return "Inherited / Theme"


def inspect_font(run):

    font = run.font

    print("      Run text:", repr(run.text))
    print("      Font name:", font.name)
    print("      Font size:", font.size.pt if font.size else None)
    print("      Bold:", font.bold)
    print("      Italic:", font.italic)
    print("      Underline:", font.underline)
    print("      Font color:", get_color(font))


def inspect_text_frame(shape):

    if not shape.has_text_frame:
        return

    print("  TEXT:", repr(shape.text))

    for p_index, paragraph in enumerate(shape.text_frame.paragraphs):

        print(f"  Paragraph {p_index}:")
        print("      Alignment:", paragraph.alignment)
        print("      Level:", paragraph.level)
        print("      Space before:", paragraph.space_before)
        print("      Space after:", paragraph.space_after)

        for run in paragraph.runs:
            inspect_font(run)


def inspect_shapes(presentation, template_name):

    print("\n" + "=" * 75)
    print(f"INSPECTING: {template_name}")
    print("=" * 75)

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\n========== SLIDE {slide_number} ==========")

        for index, shape in enumerate(slide.shapes):

            print("\n" + "-" * 60)
            print(f"Shape position in collection: {index}")
            print("Shape ID:", shape.shape_id)
            print("Shape name:", shape.name)
            print("Shape type:", shape.shape_type)

            print("Left:", shape.left)
            print("Top:", shape.top)
            print("Width:", shape.width)
            print("Height:", shape.height)

            if shape.is_placeholder:

                print("Is placeholder: YES")
                print(
                    "Placeholder type:",
                    shape.placeholder_format.type
                )
                print(
                    "Placeholder index:",
                    shape.placeholder_format.idx
                )

                if (
                    shape.placeholder_format.type
                    == PP_PLACEHOLDER.PICTURE
                ):
                    print("FIELD CATEGORY: PICTURE PLACEHOLDER")

                else:
                    print("FIELD CATEGORY: TEXT / OTHER PLACEHOLDER")

            else:
                print("Is placeholder: NO")

            if shape.has_text_frame:
                inspect_text_frame(shape)

            if shape.shape_type == 13:
                print("FIELD CATEGORY: PICTURE")
                print("Image dimensions:", shape.width, shape.height)


def inspect_layouts(presentation, template_name):

    print("\n" + "=" * 75)
    print(f"LAYOUT INSPECTION: {template_name}")
    print("=" * 75)

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\nSLIDE {slide_number} LAYOUT")

        layout = slide.slide_layout

        for shape in layout.shapes:

            if not shape.is_placeholder:
                continue

            print("\nLayout placeholder:", shape.name)
            print("Shape ID:", shape.shape_id)
            print("Placeholder type:", shape.placeholder_format.type)
            print("Placeholder index:", shape.placeholder_format.idx)
            print("Left:", shape.left)
            print("Top:", shape.top)
            print("Width:", shape.width)
            print("Height:", shape.height)

            if shape.has_text_frame:
                print("Layout text:", repr(shape.text))

                for paragraph in shape.text_frame.paragraphs:

                    for run in paragraph.runs:
                        inspect_font(run)


def inspect_presentation(file_path, template_name):

    if not file_path.exists():
        print(f"\nERROR: File not found: {file_path}")
        return

    presentation = Presentation(str(file_path))

    print("\n\n")
    print("#" * 80)
    print("TEMPLATE:", template_name)
    print("FILE:", file_path)
    print("SLIDE WIDTH:", presentation.slide_width)
    print("SLIDE HEIGHT:", presentation.slide_height)
    print("#" * 80)

    inspect_shapes(presentation, template_name)
    inspect_layouts(presentation, template_name)


def main():

    print("\nCOMPLETE ONE-PAGER TEMPLATE INSPECTION")

    # Original: inspect original text and formatting
    inspect_presentation(
        ORIGINAL_FILE,
        "ORIGINAL TEMPLATE"
    )

    # Clean: inspect reusable placeholders and positions
    inspect_presentation(
        CLEAN_FILE,
        "CLEAN TEMPLATE"
    )

    print("\n\n========== INSPECTION COMPLETED ==========")


if __name__ == "__main__":
    main()
