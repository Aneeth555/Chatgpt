 
from pathlib import Path
from pptx import Presentation


# ==================================================
# 1. PROJECT PATH
# ==================================================

BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)


# ==================================================
# 2. TARGET PLACEHOLDERS
# ==================================================

TARGET_INDICES = [79, 80]


# ==================================================
# 3. INSPECT PRODUCT LAYOUT
# ==================================================

def inspect_product_layout():

    if not TEMPLATE_FILE.exists():
        raise FileNotFoundError(
            f"Template not found: {TEMPLATE_FILE}"
        )

    presentation = Presentation(
        str(TEMPLATE_FILE)
    )

    slide = presentation.slides[0]

    layout = slide.slide_layout

    print("\n========================================")
    print("PRODUCT LAYOUT INSPECTION")
    print("========================================")

    print("Template:", TEMPLATE_FILE)
    print("Layout name:", layout.name)

    found_count = 0

    for shape in layout.shapes:

        if not shape.is_placeholder:
            continue

        placeholder_index = (
            shape.placeholder_format.idx
        )

        if placeholder_index not in TARGET_INDICES:
            continue

        found_count += 1

        print("\n----------------------------------------")
        print("PLACEHOLDER DETAILS")
        print("----------------------------------------")

        print("Placeholder index:", placeholder_index)
        print("Shape ID:", shape.shape_id)
        print("Shape name:", shape.name)
        print("Text:", repr(shape.text))

        print("\nPOSITION AND DIMENSIONS")

        print("Left:", shape.left)
        print("Top:", shape.top)
        print("Width:", shape.width)
        print("Height:", shape.height)

        if not shape.has_text_frame:
            print("No text frame available.")
            continue

        text_frame = shape.text_frame

        print("\nTEXT FRAME SETTINGS")

        print("Auto size:", text_frame.auto_size)
        print("Word wrap:", text_frame.word_wrap)
        print("Vertical anchor:", text_frame.vertical_anchor)

        print("Left margin:", text_frame.margin_left)
        print("Right margin:", text_frame.margin_right)
        print("Top margin:", text_frame.margin_top)
        print("Bottom margin:", text_frame.margin_bottom)

        print("\nPARAGRAPH DETAILS")

        for p_index, paragraph in enumerate(
            text_frame.paragraphs
        ):

            print("Paragraph:", p_index)
            print("Alignment:", paragraph.alignment)
            print("Level:", paragraph.level)

            print("Run count:", len(paragraph.runs))

            for run in paragraph.runs:

                print("Run text:", repr(run.text))
                print("Font name:", run.font.name)

                print(
                    "Font size:",
                    run.font.size.pt
                    if run.font.size else None
                )

                print("Bold:", run.font.bold)
                print("Italic:", run.font.italic)

    if found_count == 0:
        print("\nNo matching layout placeholders found.")

    print("\n========================================")
    print("INSPECTION COMPLETED")
    print("Placeholders found:", found_count)
    print("========================================")


# ==================================================
# 4. MAIN
# ==================================================

if __name__ == "__main__":

    inspect_product_layout()
