 
from pathlib import Path
from pptx import Presentation
from zipfile import ZipFile

BASE_DIR = Path(__file__).resolve().parent.parent

INPUT_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)

prs = Presentation(str(INPUT_FILE))

slide = prs.slides[0]

print("CLEAN TEMPLATE INSPECTION")
print("=" * 50)

for i, shape in enumerate(slide.shapes):

    print(f"\nShape {i}: {shape.name}")
    print("Type:", shape.shape_type)

    if shape.has_text_frame:
        print("Text:", repr(shape.text))

    if shape.is_placeholder:
        print(
            "Placeholder:",
            shape.placeholder_format.type
        )

    blips = shape._element.xpath(".//a:blip")

    if blips:
        print("IMAGE CONTENT FOUND")

        for blip in blips:
            print(
                "Relationship ID:",
                blip.get(
                    "{http://schemas.openxmlformats.org/"
                    "officeDocument/2006/relationships}embed"
                )
            )
def inspect_picture_placeholder_xml(presentation):

    for slide_number, slide in enumerate(
        presentation.slides, start=1
    ):

        print(f"\nSLIDE {slide_number} PICTURE PLACEHOLDERS")

        for shape in slide.shapes:

            if not shape.is_placeholder:
                continue

            if shape.placeholder_format.type != 18:
                continue

            placeholder_idx = shape.placeholder_format.idx

            print("\nSLIDE SHAPE:", shape.name)
            print("PLACEHOLDER INDEX:", placeholder_idx)
            print(shape._element.xml)

            print("\nMATCHING LAYOUT PLACEHOLDER")

            for layout_shape in slide.slide_layout.shapes:

                if not layout_shape.is_placeholder:
                    continue

                if layout_shape.placeholder_format.type != 18:
                    continue

                if layout_shape.placeholder_format.idx == placeholder_idx:

                    print(layout_shape.name)
                    print(layout_shape._element.xml)

inspect_picture_placeholder_xml(presentation)

print("\nEMBEDDED IMAGE FILES")
print("=" * 50)

with ZipFile(INPUT_FILE, "r") as archive:

    for name in archive.namelist():

        if name.startswith("ppt/media/"):
            print(name)
