 
from pathlib import Path

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER


# ==================================================
# 1. PROJECT PATHS
# ==================================================

BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)

OUTPUT_FILE = (
    BASE_DIR
    / "output"
    / "test_text_insertion.pptx"
)


# ==================================================
# 2. TEST DATA
# ==================================================

TEST_DATA = {
    "company_name": "TEST COMPANY"
}


# ==================================================
# 3. TEXT PLACEHOLDER MAPPING
# ==================================================

TEXT_FIELD_MAPPING = {
    "company_name": 62,
}


# ==================================================
# 4. FIND TEXT PLACEHOLDER
# ==================================================

def find_placeholder(slide, placeholder_index):

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        if (
            shape.placeholder_format.type
            == PP_PLACEHOLDER.PICTURE
        ):
            continue

        if (
            shape.placeholder_format.idx
            == placeholder_index
        ):
            return shape

    return None


# ==================================================
# 5. INSERT TEXT WHILE PRESERVING FORMATTING
# ==================================================

def insert_text(slide, field_name, value):

    placeholder_index = TEXT_FIELD_MAPPING[field_name]

    shape = find_placeholder(
        slide,
        placeholder_index
    )

    if shape is None:
        raise ValueError(
            f"Placeholder not found: {placeholder_index}"
        )

    if not shape.has_text_frame:
        raise ValueError(
            f"Placeholder has no text frame: {field_name}"
        )

    text_frame = shape.text_frame

    paragraph = text_frame.paragraphs[0]

    if paragraph.runs:

        # Reuse the existing first run
        # This preserves its font formatting

        first_run = paragraph.runs[0]

        first_run.text = str(value)

        # Remove additional runs if present
        for extra_run in list(paragraph.runs[1:]):

            extra_run._r.getparent().remove(
                extra_run._r
            )

    else:

        # No existing run is available.
        # Add a run using inherited placeholder formatting.

        run = paragraph.add_run()
        run.text = str(value)

    print("\nText inserted successfully")
    print("Field:", field_name)
    print("Value:", value)
    print("Placeholder index:", placeholder_index)
    print("Shape name:", shape.name)


# ==================================================
# 6. MAIN FUNCTION
# ==================================================

def main():

    if not TEMPLATE_FILE.exists():
        raise FileNotFoundError(
            f"Template not found: {TEMPLATE_FILE}"
        )

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    print("Loading clean PowerPoint template...")

    presentation = Presentation(
        str(TEMPLATE_FILE)
    )

    slide = presentation.slides[0]

    print("Inserting test data...")

    for field_name, value in TEST_DATA.items():

        insert_text(
            slide,
            field_name,
            value
        )

    print("\nSaving generated presentation...")

    presentation.save(
        str(OUTPUT_FILE)
    )

    print("\n================================")
    print("TEXT INSERTION TEST COMPLETED")
    print("================================")
    print("Output file:", OUTPUT_FILE)


if __name__ == "__main__":
    main()
