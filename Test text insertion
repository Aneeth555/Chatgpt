 
import json
from pathlib import Path

from pptx import Presentation
from pptx.enum.shapes import PP_PLACEHOLDER


# ==================================================
# 1. PROJECT PATHS
# ==================================================

BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)

JSON_FILE = (
    BASE_DIR
    / "output"
    / "final_extraction.json"
)

OUTPUT_FILE = (
    BASE_DIR
    / "output"
    / "test_text_insertion.pptx"
)


# ==================================================
# 2. TEXT PLACEHOLDER MAPPING
# ==================================================

COMPANY_MAPPING = {
    "company_name": 62,
    "overview": 64,
    "headquarters": 67,
    "employee_count": 95,
    "funding": 65,
    "revenue": 96,
}

PRODUCT_MAPPING = {
    "product_name": 80,
    "description": 79,
    "vertical_market": 81,
    "training_hardware": 86,
    "inference_hardware": 87,
    "route_to_market": 88,
    "deployment_type": 89,
    "models": 90,
    "ai_framework": 91,
    "serving_framework": 92,
    "additional_ai_software_stack": 94,
}


# ==================================================
# 3. LOAD JSON DATA
# ==================================================

def load_json():

    if not JSON_FILE.exists():
        raise FileNotFoundError(
            f"JSON file not found: {JSON_FILE}"
        )

    with open(JSON_FILE, "r", encoding="utf-8") as file:
        data = json.load(file)

    if not isinstance(data, dict):
        raise ValueError("JSON root must be an object.")

    company = data.get("company", {})
    product = data.get("product", {})

    if not isinstance(company, dict):
        raise ValueError("'company' must be a JSON object.")

    if not isinstance(product, dict):
        raise ValueError("'product' must be a JSON object.")

    return company, product


# ==================================================
# 4. FIND PLACEHOLDER
# ==================================================

def find_placeholder(slide, placeholder_index):

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        if (
            shape.placeholder_format.type
            == PP_PLACEHOLDER.PICTURE
        ):
            continue

        if (
            shape.placeholder_format.idx
            == placeholder_index
        ):
            return shape

    return None


# ==================================================
# 5. INSERT TEXT
# ==================================================

def insert_text(slide, field_name, value, placeholder_index):

    if value is None:
        print(f"SKIPPED: {field_name} (null)")
        return

    value = str(value).strip()

    if not value:
        print(f"SKIPPED: {field_name} (empty)")
        return

    shape = find_placeholder(
        slide,
        placeholder_index
    )

    if shape is None:
        print(
            f"WARNING: Placeholder {placeholder_index} "
            f"not found for {field_name}"
        )
        return

    if not shape.has_text_frame:
        print(f"WARNING: No text frame for {field_name}")
        return

    paragraph = shape.text_frame.paragraphs[0]

    if paragraph.runs:

        # Reuse the existing first run
        paragraph.runs[0].text = value

        # Remove additional runs
        for extra_run in list(paragraph.runs[1:]):
            extra_run._r.getparent().remove(extra_run._r)

    else:

        # Add text to the existing placeholder paragraph
        paragraph.add_run().text = value

    print(
        f"INSERTED: {field_name} "
        f"-> Placeholder {placeholder_index}"
    )


# ==================================================
# 6. POPULATE COMPANY FIELDS
# ==================================================

def populate_company_fields(slide, company):

    print("\n========== COMPANY INFORMATION ==========")

    for field_name, placeholder_index in COMPANY_MAPPING.items():

        value = company.get(field_name)

        insert_text(
            slide,
            field_name,
            value,
            placeholder_index
        )


# ==================================================
# 7. POPULATE PRODUCT FIELDS
# ==================================================

def populate_product_fields(slide, product):

    print("\n========== PRODUCT INFORMATION ==========")

    for field_name, placeholder_index in PRODUCT_MAPPING.items():

        value = product.get(field_name)

        insert_text(
            slide,
            field_name,
            value,
            placeholder_index
        )


# ==================================================
# 8. MAIN FUNCTION
# ==================================================

def main():

    print("Starting text insertion...")

    company, product = load_json()

    if not TEMPLATE_FILE.exists():
        raise FileNotFoundError(
            f"Template not found: {TEMPLATE_FILE}"
        )

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    presentation = Presentation(
        str(TEMPLATE_FILE)
    )

    slide = presentation.slides[0]

    populate_company_fields(
        slide,
        company
    )

    populate_product_fields(
        slide,
        product
    )

    presentation.save(
        str(OUTPUT_FILE)
    )

    print("\n========================================")
    print("TEXT INSERTION COMPLETED")
    print("========================================")
    print("Output:", OUTPUT_FILE)


if __name__ == "__main__":
    main()
