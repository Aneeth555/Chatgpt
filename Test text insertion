 
from pathlib import Path
import json

from pptx import Presentation
from pptx.enum.text import MSO_AUTO_SIZE


# ============================================================
# 1. PROJECT PATHS
# ============================================================

BASE_DIR = Path(__file__).resolve().parent.parent

TEMPLATE_FILE = (
    BASE_DIR
    / "templates"
    / "company_one_pager_template.pptx"
)

JSON_FILE = (
    BASE_DIR
    / "output"
    / "final one pager.json"
)

OUTPUT_FILE = (
    BASE_DIR
    / "output"
    / "test_text_insertion.pptx"
)


# ============================================================
# 2. PLACEHOLDER MAPPING
# ============================================================

COMPANY_FIELDS = {
    62: "company_name",
    64: "overview",
    67: "headquarters",
    95: "employee_count",
    65: "funding",
    96: "revenue",
}

PRODUCT_FIELDS = {
    80: "product_name",
    79: "description",
    81: "vertical_market",
    86: "training_hardware",
    87: "inference_hardware",
    88: "route_to_market",
    89: "deployment_type",
    90: "models",
    91: "ai_framework",
    92: "serving_framework",
    94: "additional_ai_software_stack",
}


# ============================================================
# 3. LOAD JSON DATA
# ============================================================

def load_json_data():

    if not JSON_FILE.exists():
        raise FileNotFoundError(
            f"JSON file not found: {JSON_FILE}"
        )

    with open(
        JSON_FILE,
        "r",
        encoding="utf-8"
    ) as file:

        data = json.load(file)

    company_data = data.get("company", {})
    product_data = data.get("product", {})

    if not isinstance(company_data, dict):
        raise ValueError(
            "The company section must be a JSON object."
        )

    if not isinstance(product_data, dict):
        raise ValueError(
            "The product section must be a JSON object."
        )

    return company_data, product_data


# ============================================================
# 4. FIND PLACEHOLDER
# ============================================================

def get_placeholder(slide, placeholder_index):

    for shape in slide.shapes:

        if not shape.is_placeholder:
            continue

        if shape.placeholder_format.idx == placeholder_index:
            return shape

    print(
        f"WARNING: Placeholder {placeholder_index} not found."
    )

    return None


# ============================================================
# 5. INSERT TEXT
# ============================================================

def insert_text(slide, placeholder_index, value):

    if value is None:
        return

    value = str(value).strip()

    if not value:
        return

    shape = get_placeholder(
        slide,
        placeholder_index
    )

    if shape is None:
        return

    if not shape.has_text_frame:
        print(
            f"WARNING: Placeholder {placeholder_index} "
            "does not have a text frame."
        )
        return

    text_frame = shape.text_frame

    # Remove existing instructional/sample text
    text_frame.clear()

    # Insert new content
    paragraph = text_frame.paragraphs[0]
    paragraph.text = value

    # Preserve the template's text-fitting behaviour
    text_frame.auto_size = MSO_AUTO_SIZE.TEXT_TO_FIT_SHAPE

    print(
        f"Inserted text into placeholder {placeholder_index}"
    )


# ============================================================
# 6. INSERT COMPANY INFORMATION
# ============================================================

def insert_company_information(slide, company_data):

    print("\n========== COMPANY INFORMATION ==========")

    for placeholder_index, json_key in COMPANY_FIELDS.items():

        value = company_data.get(json_key)

        if value is None or str(value).strip() == "":
            print(
                f"Skipped placeholder {placeholder_index}: "
                f"{json_key} is empty."
            )
            continue

        insert_text(
            slide,
            placeholder_index,
            value
        )


# ============================================================
# 7. INSERT PRODUCT INFORMATION
# ============================================================

def insert_product_information(slide, product_data):

    print("\n========== PRODUCT INFORMATION ==========")

    for placeholder_index, json_key in PRODUCT_FIELDS.items():

        value = product_data.get(json_key)

        if value is None or str(value).strip() == "":
            print(
                f"Skipped placeholder {placeholder_index}: "
                f"{json_key} is empty."
            )
            continue

        insert_text(
            slide,
            placeholder_index,
            value
        )


# ============================================================
# 8. GENERATE POWERPOINT
# ============================================================

def generate_presentation():

    print("\n========================================")
    print("ONE-PAGER TEXT INSERTION")
    print("========================================")

    # Check template
    if not TEMPLATE_FILE.exists():
        raise FileNotFoundError(
            f"Template not found: {TEMPLATE_FILE}"
        )

    # Load JSON
    company_data, product_data = load_json_data()

    # Load clean PowerPoint template
    presentation = Presentation(
        str(TEMPLATE_FILE)
    )

    if len(presentation.slides) == 0:
        raise ValueError(
            "The PowerPoint template contains no slides."
        )

    slide = presentation.slides[0]

    # Insert company details
    insert_company_information(
        slide,
        company_data
    )

    # Insert product details
    insert_product_information(
        slide,
        product_data
    )

    # Create output folder if necessary
    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    # Save editable PowerPoint
    presentation.save(
        str(OUTPUT_FILE)
    )

    print("\n========================================")
    print("POWERPOINT GENERATION COMPLETED")
    print("========================================")

    print("Output file:")
    print(OUTPUT_FILE)


# ============================================================
# 9. MAIN
# ============================================================

if __name__ == "__main__":

    generate_presentation()
