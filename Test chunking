 
from crawling.text_chunker import (
    chunk_crawled_pages
)


# ============================================================
# Sample crawled webpages
# ============================================================

crawled_pages = [

    {
        "success": True,
        "title": "Assessli Official Website",
        "url": "https://www.assessli.com/",
        "final_url": "https://www.assessli.com/",
        "domain": "assessli.com",

        "identity_verified": True,
        "identity_reason": "Verified official company domain.",
        "source_type": "official_website",
        "source_priority": 1,

        "related_fields": [
            "employee_count",
            "description"
        ],

        "content": (
            "Assessli develops AI-powered solutions. "
            "The company has 25 employees. "
            "Its platform provides personalized experiences. "
        ) * 100
    },

    {
        "success": True,
        "title": "Assessio Competitors",
        "url": "https://example.com/assessio",
        "final_url": "https://example.com/assessio",
        "domain": "example.com",

        "identity_verified": False,
        "identity_reason": "Different company detected.",
        "source_type": "other",
        "source_priority": 3,

        "related_fields": [
            "competitors"
        ],

        "content": (
            "Assessio competitors include iMocha. "
            "This information belongs to Assessio. "
        ) * 100
    }
]


# ============================================================
# Generate chunks
# ============================================================

chunks = chunk_crawled_pages(
    crawled_pages
)


# ============================================================
# Display results
# ============================================================

print("\n========== CHUNKING TEST ==========")

print("Total chunks:", len(chunks))

for chunk in chunks:

    print("\nChunk ID:", chunk["chunk_id"])
    print("Title:", chunk["title"])
    print("URL:", chunk["url"])

    print(
        "Identity verified:",
        chunk["identity_verified"]
    )

    print(
        "Source type:",
        chunk["source_type"]
    )

    print(
        "Related fields:",
        chunk["related_fields"]
    )

    print("Text preview:", chunk["text"][:150])

    print("-" * 60)
