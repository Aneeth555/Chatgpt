
import re


# ============================================================
# Chunking configuration
# ============================================================

CHUNK_SIZE = 2500
CHUNK_OVERLAP = 250


def clean_text(text):
    """
    Remove excessive whitespace from webpage content.
    """

    if not text:
        return ""

    text = text.replace("\r", "\n")
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)

    return text.strip()


def split_into_chunks(
    text,
    chunk_size=CHUNK_SIZE,
    overlap=CHUNK_OVERLAP
):
    """
    Split text into chunks while preferring paragraph
    and sentence boundaries.
    """

    if chunk_size <= 0:
        raise ValueError("chunk_size must be greater than zero.")

    if overlap < 0 or overlap >= chunk_size:
        raise ValueError(
            "overlap must be non-negative and smaller than chunk_size."
        )

    text = clean_text(text)

    if not text:
        return []

    if len(text) <= chunk_size:
        return [text]

    chunks = []
    start = 0
    text_length = len(text)

    while start < text_length:

        end = min(start + chunk_size, text_length)

        if end < text_length:

            # Prefer paragraph boundary
            boundary = text.rfind("\n\n", start, end)

            # Otherwise prefer sentence boundary
            if boundary <= start + chunk_size // 2:
                boundary = text.rfind(". ", start, end)

            # Otherwise prefer a word boundary
            if boundary <= start + chunk_size // 2:
                boundary = text.rfind(" ", start, end)

            if boundary > start:
                end = boundary + 1

        chunk = text[start:end].strip()

        if chunk:
            chunks.append(chunk)

        if end >= text_length:
            break

        next_start = max(0, end - overlap)

        # Ensure progress even if a boundary was unusually placed
        if next_start <= start:
            next_start = start + chunk_size

        start = next_start

    return chunks


def chunk_crawled_pages(crawled_pages):
    """
    Convert crawled webpages into structured chunks.

    Original source information is preserved.
    """

    all_chunks = []

    for page in crawled_pages:

        if not page.get("success"):
            continue

        content = page.get("content", "")

        if not content.strip():
            continue

        chunks = split_into_chunks(content)

        for index, chunk_text in enumerate(chunks):

            all_chunks.append({
                "chunk_id": (
                    f"{page.get('domain', 'unknown')}_"
                    f"{len(all_chunks) + 1}"
                ),
                "title": page.get("title", ""),
                "url": page.get("final_url") or page.get("url", ""),
                "domain": page.get("domain", ""),
                "related_fields": page.get("related_fields", []),
                "chunk_index": index,
                "total_chunks": len(chunks),
                "text": chunk_text
            })

    return all_chunks
